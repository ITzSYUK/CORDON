# Maintainer: CORDON-LINUX contributors
# Сборка: makepkg -si   (из каталога packaging/arch)
# Требуется локальная копия репозитория: source=("$pkgname::git+file://$PWD/../..")
pkgname=cordon-linux
pkgver=0.1.0
pkgrel=1
pkgdesc="CORDON-LINUX — лаунчер профилей и модов S.T.A.L.K.E.R. для Linux (движок OpenXRay)"
arch=('any')
url="https://github.com/ITzSYUK/CORDON"
license=('GPL-3.0-only')
depends=('python' 'python-pyqt6>=6.4' 'desktop-file-utils' 'xdg-utils')
optdepends=(
  'fuse-overlayfs: backend «fuse-overlayfs»'
  'fuse3: монтирование оверлея'
  'p7zip: установка модов из .7z'
  'libarchive: tar-архивы'
  'unrar: установка модов из .rar'
)
makedepends=('python-build' 'python-installer' 'python-wheel' 'python-setuptools' 'python-pyside6')
source=("$pkgname-$pkgver.tar.gz::$pkgname.tar.gz")
sha256sums=('SKIP')

prepare() {
  # локальная сборка из копии репозитория: распаковываем git-архив рабочего каталога
  if [[ ! -f "$pkgname.tar.gz" ]]; then
    ( cd ../.. && git archive --format=tar.gz -o "packaging/arch/$pkgname.tar.gz" HEAD )
  fi
  mkdir -p "$srcdir/$pkgname-$pkgver"
  tar -xzf "$pkgname.tar.gz" -C "$srcdir/$pkgname-$pkgver"
}

build() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/$pkgname-$pkgver"
  python -m installer --destdir="$pkgdir" --no-compile-bytecode dist/*.whl

  # PySide6 ставится системным пакетом: не тащим копию в /usr
  sed -i 's|# PySide6.*||' pyproject.toml || true

  install -Dm644 packaging/cordon-linux.desktop \
    "$pkgdir/usr/share/applications/cordon-linux.desktop"
  install -Dm644 packaging/cordon-linux.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/cordon-linux.svg"

  install -d "$pkgdir/usr/share/doc/$pkgname"
  install -Dm644 README.LINUX.md "$pkgdir/usr/share/doc/$pkgname/README.LINUX.md"
}
