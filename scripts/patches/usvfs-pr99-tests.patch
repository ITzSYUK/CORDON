+const std::vector<FILE_INFORMATION_CLASS>& supportedDirectoryInformationClasses()
+{
+  static const auto supported = [] {
+    std::vector<FILE_INFORMATION_CLASS> classes;
+    const auto path = test::path_of_test_temp(L"directory_class_support");
+    std::filesystem::create_directories(path);
+    std::ofstream(path / L"probe.txt");
+    const HANDLE directory = ::CreateFileW(
+        path.c_str(), FILE_LIST_DIRECTORY, FILE_SHARE_READ | FILE_SHARE_WRITE, nullptr,
+        OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, nullptr);
+    if (directory == INVALID_HANDLE_VALUE) {
+      ADD_FAILURE() << "cannot open the native directory-class probe";
+      return classes;
+    }
+    alignas(8) std::array<std::byte, 0x1000> buffer;
+    for (const auto informationClass : DIRECTORY_INFORMATION_CLASSES) {
+      IO_STATUS_BLOCK status;
+      const NTSTATUS result = nativeQueryDirectoryFile()(
+          directory, nullptr, nullptr, nullptr, &status, buffer.data(),
+          static_cast<ULONG>(buffer.size()), informationClass, FALSE, nullptr, TRUE);
+      if (result == STATUS_INVALID_INFO_CLASS || result == STATUS_NOT_IMPLEMENTED) {
+        std::cout << "Native directory class " << static_cast<int>(informationClass)
+                  << " is unavailable on this system\n";
+        continue;
+      }
+      EXPECT_EQ(STATUS_SUCCESS, result)
+          << "class " << static_cast<int>(informationClass);
+      if (result == STATUS_SUCCESS) {
+        classes.push_back(informationClass);
+      }
+    }
+    ::CloseHandle(directory);
+    EXPECT_GE(classes.size(), 6u) << "basic native directory classes are unavailable";
+    return classes;
+  }();
+  return supported;
+}
