@@ -1821,0 +1885,76 @@ std::vector<std::wstring> recordNames(const DirectoryRecordLayout& layout,
+// Native batches can be shorter than the records permit; check virtual packing separately.
+void listCheckedNames(NtQueryDirectoryFile_type query, HANDLE directory,
+                      ListingQuery listing, size_t entryCount,
+                      std::vector<std::wstring>& names, bool changeClass = false,
+                      std::span<const std::wstring> packedNames = {})
+{
+  const auto& classes = supportedDirectoryInformationClasses();
+  size_t classIndex =
+      std::ranges::find(classes, listing.informationClass) - classes.begin();
+  for (size_t call = 0; call <= entryCount; ++call) {
+    SCOPED_TRACE(call);
+    listing.informationClass = classes[classIndex];
+    ListingQuery current = listing;
+    const DirectoryRecordLayout layout =
+        findDirectoryRecordLayout(current.informationClass).value();
+    ListedQuery result = queryOnce(query, directory, current);
+    // A larger information class may need more room for the same next file.
+    if (result.outcome.result == STATUS_BUFFER_OVERFLOW ||
+        (result.outcome.result == STATUS_SUCCESS && result.data.empty())) {
+      ASSERT_TRUE(changeClass);
+      ASSERT_EQ(result.outcome.result, result.outcome.statusBlock.Status);
+      if (result.outcome.result == STATUS_BUFFER_OVERFLOW) {
+        ASSERT_TRUE(DirectoryRecord(layout, result.data).isTruncated());
+      }
+      current.length = 0x1000;
+      result = queryOnce(query, directory, current);
+    }
+    if (result.outcome.result == STATUS_NO_MORE_FILES) {
+      ASSERT_EQ(entryCount, names.size());
+      return;
+    }
+    ASSERT_EQ(STATUS_SUCCESS, result.outcome.result);
+    ASSERT_EQ(STATUS_SUCCESS, result.outcome.statusBlock.Status);
+    ASSERT_FALSE(result.data.empty());
+    ASSERT_LE(result.data.size(), current.length);
+    size_t offset = 0;
+    size_t count = 0;
+    for (;;) {
+      ASSERT_GE(result.data.size() - offset, layout.fileNameOffset);
+      const DirectoryRecord record(layout, std::span(result.data).subspan(offset));
+      ASSERT_FALSE(record.isTruncated());
+      ASSERT_EQ(0u, record.fileNameLength() % sizeof(WCHAR));
+      if (!packedNames.empty()) {
+        ASSERT_LT(names.size(), packedNames.size());
+        ASSERT_EQ(packedNames[names.size()], record.fileName());
+      }
+      names.push_back(record.fileName());
+      ++count;
+      if (record.nextEntryOffset() == 0) {
+        ASSERT_EQ(result.data.size(), offset + record.size());
+        break;
+      }
+      ASSERT_EQ(0u, record.nextEntryOffset() % 8);
+      ASSERT_GE(record.nextEntryOffset(), record.size());
+      if (!packedNames.empty()) {
+        ASSERT_EQ((record.size() + 7u) / 8u * 8u, record.nextEntryOffset());
+      }
+      ASSERT_LT(record.nextEntryOffset(), result.data.size() - offset);
+      offset += record.nextEntryOffset();
+    }
+    if (listing.isSingleEntry) {
+      ASSERT_EQ(1u, count);
+    } else if (names.size() < packedNames.size()) {
+      const size_t nextOffset = (result.data.size() + 7u) / 8u * 8u;
+      const size_t nextSize = layout.fileNameOffset +
+                              packedNames[names.size()].size() * sizeof(WCHAR);
+      ASSERT_GT(nextOffset + nextSize, current.length)
+          << "virtual query left room for the next matching entry";
+    }
+    if (changeClass) {
+      classIndex = (classIndex + 1) % classes.size();
+    }
+  }
+  FAIL() << "listing did not terminate";
+}
