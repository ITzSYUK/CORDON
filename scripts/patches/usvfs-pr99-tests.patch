@@ -1975,0 +2145,60 @@ std::vector<std::wstring> sortedNames(const std::vector<ListedQuery>& queries)
+TEST_F(USVFSTest, NtQueryDirectoryFilePreservesUnavailableClassesAndScanState)
+{
+  auto params = defaultUsvfsParams();
+  std::unique_ptr<usvfs::HookContext> ctx(
+      usvfsCreateHookContext(*params, ::GetModuleHandle(nullptr)));
+  addVirtualEntries(ctx->redirectionTable());
+  std::vector<FILE_INFORMATION_CLASS> unavailable{FileStandardInformation};
+  const auto& supported = supportedDirectoryInformationClasses();
+  for (const auto informationClass : DIRECTORY_INFORMATION_CLASSES) {
+    if (std::ranges::find(supported, informationClass) == supported.end()) {
+      unavailable.push_back(informationClass);
+    }
+  }
+  usvfs::UnicodeString rejectedPattern(L"usvfs_must_not_latch_*");
+  for (const auto informationClass : unavailable) {
+    for (const bool isEx : {false, true}) {
+      SCOPED_TRACE(
+          std::format("class {}, Ex {}", static_cast<int>(informationClass), isEx));
+      HANDLE native  = openRootDirectory(true);
+      HANDLE hooked  = openRootDirectory(true);
+      HANDLE control = openRootDirectory(true);
+      ASSERT_NE(INVALID_HANDLE_VALUE, native);
+      ASSERT_NE(INVALID_HANDLE_VALUE, hooked);
+      ASSERT_NE(INVALID_HANDLE_VALUE, control);
+      const BufferQuery rejected{informationClass, isEx, 0, 0x1000};
+      const QueryOutcome expected = queryBuffer(
+          true, native, rejected, static_cast<PUNICODE_STRING>(rejectedPattern));
+      ASSERT_LT(expected.result, 0);
+      expectSameOutcome(expected,
+                        queryBuffer(false, hooked, rejected,
+                                    static_cast<PUNICODE_STRING>(rejectedPattern)));
+
+      const ListingQuery first{FileDirectoryInformation, 0x1000, true,
+                               L"usvfs_notified_*"};
+      const ListedQuery actualFirst =
+          queryOnce(&usvfs::hook_NtQueryDirectoryFile, hooked, first);
+      const ListedQuery controlFirst =
+          queryOnce(&usvfs::hook_NtQueryDirectoryFile, control, first);
+      ASSERT_EQ(STATUS_SUCCESS, actualFirst.outcome.result);
+      expectSameOutcome(controlFirst.outcome, actualFirst.outcome);
+      EXPECT_EQ(sortedNames({controlFirst}), sortedNames({actualFirst}));
+
+      // A rejected restart must not rewind the virtual cursor or replace its pattern.
+      expectSameOutcome(expected,
+                        queryBuffer(false, hooked, rejected,
+                                    static_cast<PUNICODE_STRING>(rejectedPattern)));
+      const ListingQuery rest{FileDirectoryInformation, 0x1000, false, std::nullopt};
+      const auto actualRest =
+          listQueries(&usvfs::hook_NtQueryDirectoryFile, hooked, rest);
+      const auto controlRest =
+          listQueries(&usvfs::hook_NtQueryDirectoryFile, control, rest);
+      EXPECT_EQ(sortedNames(controlRest), sortedNames(actualRest));
+      EXPECT_EQ(STATUS_NO_MORE_FILES, actualRest.back().outcome.result);
+      usvfs::hook_NtClose(native);
+      usvfs::hook_NtClose(hooked);
+      usvfs::hook_NtClose(control);
+    }
+  }
+}
