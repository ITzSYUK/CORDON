diff --git a/src/usvfs_dll/hooks/internal_io.h b/src/usvfs_dll/hooks/internal_io.h
new file mode 100644
index 0000000..08772cd
--- /dev/null
+++ b/src/usvfs_dll/hooks/internal_io.h
@@ -0,0 +1,69 @@
+#pragma once
+
+#include "../hookcontext.h"
+#include <Windows.h>
+#include <exception>
+#include <new>
+#include <utility>
+
+// Suppress rerouting of the directory scanner's own opens and closes, per thread.
+class InternalIoScope
+{
+public:
+  InternalIoScope()
+  {
+    PreserveGetLastError preserve;
+    if (s_slot.index == TLS_OUT_OF_INDEXES) {
+      throw std::bad_alloc();
+    }
+    m_previous = ::TlsGetValue(s_slot.index);
+    if (!::TlsSetValue(s_slot.index, reinterpret_cast<void*>(1))) {
+      throw std::bad_alloc();
+    }
+  }
+
+  ~InternalIoScope()
+  {
+    PreserveGetLastError preserve;
+    // Restore an already populated slot: no allocation or thread cleanup is needed.
+    if (!::TlsSetValue(s_slot.index, m_previous)) {
+      std::terminate();
+    }
+  }
+
+  InternalIoScope(const InternalIoScope&)            = delete;
+  InternalIoScope& operator=(const InternalIoScope&) = delete;
+
+  static bool isActive()
+  {
+    PreserveGetLastError preserve;
+    return s_slot.index != TLS_OUT_OF_INDEXES && ::TlsGetValue(s_slot.index) != nullptr;
+  }
+
+private:
+  // Some native threads have no compiler TLS vector; Win32 TLS does not use it.
+  struct Slot
+  {
+    Slot()
+    {
+      PreserveGetLastError preserve;
+      index = ::TlsAlloc();
+    }
+
+    ~Slot()
+    {
+      PreserveGetLastError preserve;
+      if (index != TLS_OUT_OF_INDEXES) {
+        ::TlsFree(std::exchange(index, TLS_OUT_OF_INDEXES));
+      }
+    }
+
+    DWORD index = TLS_OUT_OF_INDEXES;
+  };
+
+  static Slot s_slot;
+  // Each nested scope restores the outer scope's flag.
+  void* m_previous = nullptr;
+};
+
+inline InternalIoScope::Slot InternalIoScope::s_slot;
