+std::once_flag directoryClassProbeOnce;
+std::array<bool, 4> unavailableDirectoryClasses{};
+
+bool isDirectoryClassUnavailable(FILE_INFORMATION_CLASS informationClass)
+{
+  if (informationClass < FileId64ExtdDirectoryInformation ||
+      informationClass > FileIdAllExtdBothDirectoryInformation) {
+    return false;
+  }
+  // Probe only the newer kernel classes, once, using handles independent of callers.
+  std::call_once(directoryClassProbeOnce, [] {
+    WCHAR systemDirectory[MAX_PATH];
+    const UINT length = ::GetSystemDirectoryW(systemDirectory, MAX_PATH);
+    if (length == 0 || length >= MAX_PATH) {
+      return;
+    }
+    std::vector<std::byte> buffer;
+    for (size_t index = 0; index < unavailableDirectoryClasses.size(); ++index) {
+      OpenedDirectory directory = openScanDirectory(systemDirectory);
+      if (!directory.handle.isValid()) {
+        break;
+      }
+      const auto probeClass =
+          static_cast<FILE_INFORMATION_CLASS>(FileId64ExtdDirectoryInformation + index);
+      NativeDirectoryReader reader(std::move(directory.handle),
+                                   *findDirectoryRecordLayout(probeClass), std::nullopt,
+                                   buffer);
+      reader.next();
+      unavailableDirectoryClasses[index] =
+          reader.endStatus() == STATUS_INVALID_INFO_CLASS ||
+          reader.endStatus() == STATUS_NOT_IMPLEMENTED;
+    }
+  });
+  return unavailableDirectoryClasses[informationClass -
+                                     FileId64ExtdDirectoryInformation];
+}
