diff --git a/test/tvfs_test/internal_io_test.cpp b/test/tvfs_test/internal_io_test.cpp
new file mode 100644
index 0000000..3fe611b
--- /dev/null
+++ b/test/tvfs_test/internal_io_test.cpp
@@ -0,0 +1,112 @@
+#include "pch.h"
+
+#include <thread>
+#include <memory>
+#include <gtest/gtest.h>
+#include <hooks/internal_io.h>
+#include <hookcontext.h>
+#include "tvfs_test.h"
+
+namespace
+{
+
+__declspec(noinline) bool exerciseScope(void* context)
+{
+  const bool initiallyActive = context != nullptr;
+  if (InternalIoScope::isActive() != initiallyActive) {
+    return false;
+  }
+  {
+    const InternalIoScope outer;
+    if (!InternalIoScope::isActive()) {
+      return false;
+    }
+    {
+      const InternalIoScope inner;
+      if (!InternalIoScope::isActive()) {
+        return false;
+      }
+    }
+    if (!InternalIoScope::isActive()) {
+      return false;
+    }
+  }
+  return InternalIoScope::isActive() == initiallyActive;
+}
+
+// Test only: TEB static TLS vector at 0x58 (x64) / 0x2c (x86), restored before CRT use.
+DWORD exerciseWithoutStaticTls(bool (*probe)(void*), void* context, bool* matched)
+{
+  PVOID volatile* storage = reinterpret_cast<PVOID volatile*>(NtCurrentTeb()) + 11;
+  PVOID saved = *storage;
+  DWORD exception = 0;
+  __try {
+    *storage = nullptr;
+    *matched = probe(context);
+  } __except (EXCEPTION_EXECUTE_HANDLER) {
+    exception = GetExceptionCode();
+  }
+  *storage = saved;
+  return exception;
+}
+
+bool closeHookedEvent(void* handle)
+{
+  constexpr DWORD SENTINEL = 0x12345678;
+  ::SetLastError(SENTINEL);
+  const NTSTATUS result = usvfs::hook_NtClose(handle);
+  const DWORD lastError = ::GetLastError();
+  return result == STATUS_SUCCESS && lastError == SENTINEL;
+}
+
+}  // namespace
+
+TEST(InternalIoScopeTest, PreservesNestingAndLastError)
+{
+  constexpr DWORD SENTINEL = 0x12345678;
+  ::SetLastError(SENTINEL);
+  const bool matched = exerciseScope(nullptr);
+  const DWORD lastError = ::GetLastError();
+  EXPECT_TRUE(matched);
+  EXPECT_EQ(SENTINEL, lastError);
+}
+
+TEST(InternalIoScopeTest, IsolatesThreads)
+{
+  const InternalIoScope outer;
+  bool matched = false;
+  std::thread worker([&] { matched = exerciseScope(nullptr); });
+  worker.join();
+  EXPECT_TRUE(matched);
+  EXPECT_TRUE(InternalIoScope::isActive());
+}
+
+TEST(InternalIoScopeTest, WorksWithoutStaticTlsVector)
+{
+  bool matched = false;
+  EXPECT_EQ(0u, exerciseWithoutStaticTls(exerciseScope, nullptr, &matched));
+  EXPECT_TRUE(matched);
+  {
+    const InternalIoScope outer;
+    matched = false;
+    EXPECT_EQ(0u, exerciseWithoutStaticTls(exerciseScope, &matched, &matched));
+    EXPECT_TRUE(matched);
+  }
+  EXPECT_FALSE(InternalIoScope::isActive());
+}
+
+TEST_F(USVFSTest, NtCloseWorksWithoutStaticTlsVector)
+{
+  auto params = defaultUsvfsParams();
+  std::unique_ptr<usvfs::HookContext> ctx(
+      usvfsCreateHookContext(*params, ::GetModuleHandle(nullptr)));
+  HANDLE event = ::CreateEventW(nullptr, FALSE, FALSE, nullptr);
+  ASSERT_NE(nullptr, event);
+  bool matched = false;
+  const DWORD exception = exerciseWithoutStaticTls(closeHookedEvent, event, &matched);
+  if (exception != 0) {
+    ::CloseHandle(event);
+  }
+  EXPECT_EQ(0u, exception);
+  EXPECT_TRUE(matched);
+}
