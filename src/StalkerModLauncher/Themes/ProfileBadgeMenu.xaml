<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infrastructure="clr-namespace:StalkerModLauncher.Infrastructure">
    <infrastructure:ProfileBadgeImageConverter x:Key="ProfileBadgeImages"/>
    <Style x:Key="ProfileBadgeImageStyle" TargetType="Image">
        <Setter Property="Source" Value="{Binding Badge, Converter={StaticResource ProfileBadgeImages}}"/>
        <Setter Property="Width" Value="28"/>
        <Setter Property="Height" Value="28"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="Fant"/>
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Badge}" Value="Monolith">
                <Setter Property="RenderTransform">
                    <Setter.Value><ScaleTransform ScaleX="1.15" ScaleY="1.15"/></Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <ControlTemplate x:Key="ProfileBadgeMenuTemplate" TargetType="ContextMenu">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="4"
                Padding="{TemplateBinding Padding}">
            <ScrollViewer Height="190" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled" CanContentScroll="True">
                <ItemsPresenter/>
            </ScrollViewer>
        </Border>
    </ControlTemplate>
</ResourceDictionary>
