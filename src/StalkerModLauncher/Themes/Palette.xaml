<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="WindowBackgroundColor">#0F110D</Color>
    <Color x:Key="PanelAltColor">#272B20</Color>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#191D15"/>
    <SolidColorBrush x:Key="CommandPanelBrush" Color="#202318"/>
    <SolidColorBrush x:Key="FieldBackgroundBrush" Color="#11140F"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}"/>
    <SolidColorBrush x:Key="PanelHoverBrush" Color="#323729"/>
    <SolidColorBrush x:Key="PanelPressedBrush" Color="#3C422F"/>
    <SolidColorBrush x:Key="ModSelectionBrush" Color="#3A3325"/>
    <SolidColorBrush x:Key="ModRelatedBrush" Color="#34301F"/>
    <SolidColorBrush x:Key="ModRelatedStrokeBrush" Color="#7B7042"/>
    <SolidColorBrush x:Key="ModActionShadeBrush" Color="#B3000000"/>
    <SolidColorBrush x:Key="ModArchiveProgressPanelBrush" Color="#202318"/>
    <SolidColorBrush x:Key="ModArchiveProgressTrackBrush" Color="#11140F"/>
    <SolidColorBrush x:Key="ModArchiveProgressFillBrush" Color="#C98A2E"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#4A4E3A"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F0E8C8"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#B2AD91"/>
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#8D8878"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#C98A2E"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#D79A3D"/>
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#A86D23"/>
    <SolidColorBrush x:Key="AccentGreenBrush" Color="#87A15A"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#AD5848"/>
    <SolidColorBrush x:Key="LauncherSettingsPageBrush" Color="{StaticResource WindowBackgroundColor}"/>
    <SolidColorBrush x:Key="LauncherSettingsCardBrush" Color="{StaticResource PanelAltColor}"/>
    <CornerRadius x:Key="LauncherSettingsPanelCornerRadius">6</CornerRadius>
    <CornerRadius x:Key="ProfileSettingPanelCornerRadius">0,6,6,0</CornerRadius>
</ResourceDictionary>
