<UserControl x:Class="StalkerModLauncher.Views.Controls.PdaMo2ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:StalkerModLauncher.Resources"
             xmlns:themes="clr-namespace:StalkerModLauncher.Themes"
             Background="{DynamicResource PdaPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{x:Static themes:PdaThemeSelector.CurrentSource}"/>
                <ResourceDictionary Source="/CORDON;component/Themes/Mo2ImportStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10,5,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Mo2StepTitleStyle}" FontSize="12"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#x26A0;" Margin="0,0,6,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource DangerBrush}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMessageWarning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12"
                               TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Message}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMessageWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{x:Static res:Strings.Common_Cancel}" Click="CancelButton_OnClick" Margin="0,0,6,0"/>
                <Button Content="{x:Static res:Strings.Common_Back}" Command="{Binding BackCommand}" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PdaBaseButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSourceStep}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static res:Strings.Mo2_Preview}" Command="{Binding NextCommand}"
                        ToolTipService.ShowOnDisabled="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSourceStep}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="ToolTip" Value="{Binding NextBlockedReason}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static res:Strings.Mo2_CreateProfile}" Command="{Binding ImportCommand}"
                        ToolTipService.ShowOnDisabled="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewStep}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="ToolTip" Value="{Binding ImportBlockedReason}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Margin="0,0,0,5" FontSize="11" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Text="{Binding ImportBlockedReason}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPreviewStep}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ImportBlockedReason}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="2" Background="{DynamicResource PdaInsetPanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSourceStep}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="{x:Static res:Strings.Mo2_Source}" FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourcePathTextBox" Text="{Binding SourceDisplay, Mode=OneWay}" IsReadOnly="True"
                                     ToolTip="{Binding SourcePath}">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasSource}" Value="False">
                                                <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                            <Button Grid.Column="1" Content="{x:Static res:Strings.Mo2_SourceFolder}" Command="{Binding BrowseSourceFolderCommand}" Margin="7,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Mo2_Or}" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            <Button Grid.Column="3" Content="{x:Static res:Strings.Mo2_ModListFile}" Command="{Binding BrowseModListCommand}" Margin="7,0,0,0"/>
                        </Grid>

                        <TextBlock Text="{x:Static res:Strings.Mo2_Profile}" FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,10"/>
                        <Grid>
                            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedMo2Profile}"
                                      DisplayMemberPath="Name" Style="{StaticResource Mo2ComboBoxStyle}"
                                      Height="{Binding ActualHeight, ElementName=SourcePathTextBox}"
                                      ToolTip="{Binding SelectedMo2Profile.Name}"/>
                            <TextBlock Text="{x:Static res:Strings.Mo2_SelectProfilePlaceholder}"
                                       FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Mo2PlaceholderTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="FontSize" Value="12"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedMo2Profile}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="{x:Static res:Strings.Mo2_DetectedPaths}" FontFamily="Bahnschrift SemiCondensed" FontSize="15" Margin="0,18,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:Strings.Common_BaseGame}" FontSize="12"/>
                                <TextBlock Text="*" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" Text="{Binding GamePath}" IsReadOnly="True"
                                     ToolTip="{Binding GamePath}" Margin="0,0,7,2" FontSize="12"/>
                            <Button Grid.Column="2" Content="{x:Static res:Strings.Common_Change}" Command="{Binding BrowseGameCommand}" Margin="0,0,0,2"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static res:Strings.Mo2_PathNotFound}"
                                       Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,0,0,5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsGamePathValid}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:Strings.Mo2_ModsFolder}" FontSize="12"/>
                                <TextBlock Text="*" Foreground="{DynamicResource DangerBrush}" FontSize="12" Margin="2,0,0,0" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ModsPath}" IsReadOnly="True"
                                     ToolTip="{Binding ModsPath}" Margin="0,0,7,2" FontSize="12"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="{x:Static res:Strings.Common_Change}" Command="{Binding BrowseModsCommand}" Margin="0,0,0,2"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Static res:Strings.Mo2_PathNotFound}"
                                       Foreground="{DynamicResource DangerBrush}" FontSize="11" Margin="0,0,0,5">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModsPathValid}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Row="4" Text="{x:Static res:Strings.Mo2_OverwriteFolder}" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OverwritePath}" IsReadOnly="True"
                                     ToolTip="{Binding OverwritePath}" Margin="0,0,7,0" FontSize="12"/>
                            <Button Grid.Row="4" Grid.Column="2" Content="{x:Static res:Strings.Common_Change}" Command="{Binding BrowseOverwriteCommand}"/>
                        </Grid>
                        <TextBlock Text="{x:Static res:Strings.Mo2_ReadOnlyHint}"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,9,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="{x:Static res:Strings.Mo2_RequiredFieldsHint}"
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewStep}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Static res:Strings.Mo2_NewProfile}" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Column="1" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,7,0,6" HorizontalAlignment="Stretch">
                        <TextBlock Text="{Binding PreviewSummary}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Stretch"/>
                        <TextBlock Text="{Binding Preview.ExecutableSummary}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" HorizontalAlignment="Stretch"
                                   ToolTip="{Binding Preview.ExecutableSummary}"/>
                        <TextBlock Text="{Binding Preview.OverwriteSummary}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" HorizontalAlignment="Stretch"
                                   ToolTip="{Binding Preview.OverwriteSummary}"/>
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" FontSize="11"/>
                            <!-- Hint aligned to the TextBox text origin (19,11): 1px border plus doubled 8,5 padding, verified by render test. -->
                            <TextBlock Text="{x:Static res:Strings.Mo2_SearchPlaceholder}" FontSize="11" Margin="19,11,0,0" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Mo2PlaceholderTextStyle}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Setter Property="FontSize" Value="11"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <CheckBox Grid.Row="1" Content="{x:Static res:Strings.Mo2_ShowOnlyProblems}"
                                  IsChecked="{Binding ShowOnlyProblems}" FontSize="10" Margin="0,6,0,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Strings.SettingsProfile_LaunchMode}"
                                       Foreground="{StaticResource MutedTextBrush}" FontSize="10" Margin="0,0,8,0"
                                       VerticalAlignment="Center" ToolTip="{x:Static res:Strings.Mo2_LaunchModeHint}"/>
                            <RadioButton Content="Workspace" IsChecked="{Binding UseLinkedWorkspace}" FontSize="10" Margin="0,0,10,0" VerticalAlignment="Center"
                                           Style="{StaticResource Mo2LaunchRadioButtonStyle}"/>
                            <RadioButton Content="USVFS" IsChecked="{Binding UseVirtualFileSystem}" FontSize="10" VerticalAlignment="Center"
                                           Style="{StaticResource Mo2LaunchRadioButtonStyle}"/>
                            <TextBlock Text="?" Foreground="{StaticResource MutedTextBrush}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                       ToolTip="{x:Static res:Strings.Mo2_LaunchModeHint}" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                    <DataGrid Grid.Row="3" ItemsSource="{Binding VisibleEntries}" AutoGenerateColumns="False"
                              Style="{StaticResource Mo2DataGridStyle}" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" FontSize="11">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="34"/>
                            <DataGridCheckBoxColumn Header="{x:Static res:Strings.Mo2_Enabled}" Binding="{Binding IsEnabled, Mode=OneWay}" Width="56">
                                <DataGridCheckBoxColumn.ElementStyle>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                        <Setter Property="ToolTip" Value="{x:Static res:Strings.Mo2_EnabledReadOnlyHint}"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridCheckBoxColumn.ElementStyle>
                            </DataGridCheckBoxColumn>
                            <DataGridTextColumn Header="{x:Static res:Strings.Common_Mod}" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="{x:Static res:Strings.Mo2_Group}" Binding="{Binding GroupName}" Width="*"/>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Common_Status}" Width="140" SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" ToolTip="{Binding Status}">
                                            <TextBlock Text="&#x25CF;" Margin="0,0,5,0" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsAmbiguous}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="{x:Static res:Strings.Common_Folder}" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid ToolTip="{Binding SourcePath}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding PathDisplay}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" ToolTip="{Binding SourcePath}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMultipleCandidates}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Grid Grid.ColumnSpan="2">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMultipleCandidates}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>
                                                <ComboBox ItemsSource="{Binding CandidateOptions}"
                                                          SelectedValuePath="Path"
                                                          SelectedValue="{Binding SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          ToolTip="{x:Static res:Strings.Mo2_SelectMatchingFolder}">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox" BasedOn="{StaticResource Mo2ComboBoxStyle}">
                                                            <Setter Property="MinHeight" Value="24"/>
                                                            <Setter Property="Padding" Value="5,2"/>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>
                                                <TextBlock Text="{x:Static res:Strings.Mo2_SelectFolderPlaceholder}"
                                                           IsHitTestVisible="False" VerticalAlignment="Center" Margin="10,0,28,0"
                                                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                            <Button Grid.Column="1" Content="{x:Static res:Strings.Mo2Service_SelectFolder}"
                                                    Command="{Binding DataContext.BrowseMissingModFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" Margin="6,0,0,0" Padding="6,1">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PdaBaseButtonStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding CanBrowseSource}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <CheckBox Grid.Row="4"
                              Content="{x:Static res:Strings.Mo2_EnableOverwrite}"
                              IsChecked="{Binding IncludeOverwrite}" IsEnabled="{Binding Preview.HasOverwriteContent}"
                              Margin="0,7,0,0" FontSize="10"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
