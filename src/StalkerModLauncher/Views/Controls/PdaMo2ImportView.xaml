<UserControl x:Class="StalkerModLauncher.Views.Controls.PdaMo2ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:StalkerModLauncher.Resources"
             xmlns:controls="clr-namespace:StalkerModLauncher.Views.Controls"
             xmlns:themes="clr-namespace:StalkerModLauncher.Themes"
             Background="{DynamicResource PdaPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{x:Static themes:PdaThemeSelector.CurrentSource}"/>
                <ResourceDictionary Source="/CORDON;component/Themes/Mo2ImportStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10,5,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding StepTitle}" Style="{StaticResource Mo2StepTitleStyle}" FontSize="12"/>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#x26A0;" Margin="0,0,6,0" VerticalAlignment="Top"
                               Foreground="{DynamicResource DangerBrush}" FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMessageWarning}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="1" Text="{Binding Message}" FontSize="12"
                               TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Message}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMessageWarning}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="{x:Static res:Strings.Common_Cancel}" Click="CancelButton_OnClick" Margin="0,0,6,0"/>
                <Button Content="{x:Static res:Strings.Common_Back}" Command="{Binding BackCommand}" Margin="0,0,6,0">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PdaBaseButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSourceStep}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static res:Strings.Mo2_Preview}" Command="{Binding NextCommand}"
                        ToolTipService.ShowOnDisabled="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSourceStep}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="ToolTip" Value="{Binding NextBlockedReason}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="{x:Static res:Strings.Mo2_CreateProfile}" Command="{Binding ImportCommand}"
                        ToolTipService.ShowOnDisabled="True">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewStep}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="ToolTip" Value="{Binding ImportBlockedReason}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1" Margin="0,0,0,5" FontSize="11" Foreground="{DynamicResource DangerBrush}"
                   TextWrapping="Wrap" Text="{Binding ImportBlockedReason}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPreviewStep}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ImportBlockedReason}" Value="">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <Border Grid.Row="2" Background="{DynamicResource PdaInsetPanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="12">
            <controls:Mo2ImportContentView x:Name="ImportContent" UsePdaTheme="True"/>
        </Border>
    </Grid>
</UserControl>
