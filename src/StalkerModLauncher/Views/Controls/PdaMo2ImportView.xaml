<UserControl x:Class="StalkerModLauncher.Views.Controls.PdaMo2ImportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:StalkerModLauncher.Themes"
             Background="{DynamicResource PdaPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{x:Static themes:PdaThemeSelector.CurrentSource}"/>
                <ResourceDictionary Source="/CORDON;component/Themes/Mo2ImportStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10,5,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Message}" FontSize="12" TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMessageWarning}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button Content="Отмена" Click="CancelButton_OnClick" Margin="0,0,6,0"/>
                <Button Content="Назад" Command="{Binding BackCommand}" Margin="0,0,6,0"/>
                <Button Content="Предпросмотр" Command="{Binding NextCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PdaBaseButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSourceStep}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="Создать профиль" Command="{Binding ImportCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewStep}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource PdaInsetPanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="12">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSourceStep}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="ИСТОЧНИК MO2" FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourcePathTextBox" Text="{Binding SourcePath, Mode=OneWay}" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="Папка MO2" Command="{Binding BrowseSourceFolderCommand}" Margin="7,0,0,0"/>
                            <TextBlock Grid.Column="2" Text="или" VerticalAlignment="Center" Margin="7,0,0,0"/>
                            <Button Grid.Column="3" Content="Файл modlist.txt" Command="{Binding BrowseModListCommand}" Margin="7,0,0,0"/>
                        </Grid>

                        <TextBlock Text="ПРОФИЛЬ MO2" FontFamily="Bahnschrift SemiCondensed" FontSize="17" FontWeight="SemiBold" Margin="0,14,0,10"/>
                        <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedMo2Profile}"
                                  DisplayMemberPath="Name" Style="{StaticResource Mo2ComboBoxStyle}"
                                  Height="{Binding ActualHeight, ElementName=SourcePathTextBox}"/>

                        <TextBlock Text="ОБНАРУЖЕННЫЕ ПУТИ" FontFamily="Bahnschrift SemiCondensed" FontSize="15" Margin="0,18,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Базовая игра" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding GamePath}" IsReadOnly="True" Margin="0,0,7,5"/>
                            <Button Grid.Column="2" Content="Изменить" Command="{Binding BrowseGameCommand}" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="1" Text="Папка mods" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding ModsPath}" IsReadOnly="True" Margin="0,0,7,5"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="Изменить" Command="{Binding BrowseModsCommand}" Margin="0,0,0,5"/>
                            <TextBlock Grid.Row="2" Text="Папка overwrite" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding OverwritePath}" IsReadOnly="True" Margin="0,0,7,0"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="Изменить" Command="{Binding BrowseOverwriteCommand}"/>
                        </Grid>
                        <TextBlock Text="Исходные папки игры, mods и overwrite лаунчер не изменяет."
                                   Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,9,0,0"/>
                    </StackPanel>
                </ScrollViewer>

                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsPreviewStep}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Новый профиль" VerticalAlignment="Center" FontSize="11"/>
                        <TextBox Grid.Column="1" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                    </Grid>
                    <StackPanel Grid.Row="1" Margin="0,7,0,6">
                        <TextBlock Text="{Binding PreviewSummary}" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding Preview.ExecutableSummary}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        <TextBlock Text="{Binding Preview.OverwriteSummary}" Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                    </StackPanel>
                    <DataGrid Grid.Row="2" ItemsSource="{Binding Preview.Entries}" AutoGenerateColumns="False"
                              Style="{StaticResource Mo2DataGridStyle}" IsReadOnly="True" CanUserAddRows="False"
                              SelectionMode="Single" FontSize="10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="34"/>
                            <DataGridCheckBoxColumn Header="Вкл." Binding="{Binding IsEnabled, Mode=OneWay}" Width="44"/>
                            <DataGridTextColumn Header="Мод" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Группа" Binding="{Binding GroupName}" Width="*"/>
                            <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="125"/>
                            <DataGridTemplateColumn Header="Папка" Width="2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <TextBlock Text="{Binding PathDisplay}" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMultipleCandidates}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <ComboBox ItemsSource="{Binding CandidateOptions}"
                                                      SelectedValuePath="Path"
                                                      SelectedValue="{Binding SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="Выберите папку, которая соответствует этому моду">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox" BasedOn="{StaticResource Mo2ComboBoxStyle}">
                                                        <Setter Property="MinHeight" Value="24"/>
                                                        <Setter Property="Padding" Value="5,2"/>
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasMultipleCandidates}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ComboBox.Style>
                                            </ComboBox>
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <CheckBox Grid.Row="3"
                              Content="Подключить файлы из MO2 overwrite отдельным слоем с максимальным приоритетом"
                              IsChecked="{Binding IncludeOverwrite}" IsEnabled="{Binding Preview.HasOverwriteContent}"
                              Margin="0,7,0,0" FontSize="10"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
