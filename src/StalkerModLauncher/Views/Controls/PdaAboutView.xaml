<UserControl x:Class="StalkerModLauncher.Views.Controls.PdaAboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:StalkerModLauncher.Themes"
             xmlns:controls="clr-namespace:StalkerModLauncher.Views.Controls"
             Background="{DynamicResource WindowBackgroundBrush}"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{x:Static themes:PdaThemeSelector.CurrentSource}"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="CORDON"
                       FontFamily="Bahnschrift SemiCondensed"
                       FontSize="21"
                       Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="S.T.A.L.K.E.R. Mod Launcher"
                       FontFamily="Bahnschrift SemiCondensed"
                       FontSize="14"
                       Foreground="{DynamicResource MutedTextBrush}"
                       Margin="0,1,0,0"/>
            <TextBlock x:Name="VersionText"
                       Foreground="{DynamicResource MutedTextBrush}"
                       FontSize="11"
                       Margin="0,2,0,10"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <controls:AboutContentView Margin="0,0,8,0"/>
        </ScrollViewer>
    </Grid>
</UserControl>
