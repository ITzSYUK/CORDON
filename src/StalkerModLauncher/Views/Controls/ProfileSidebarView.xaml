<UserControl x:Class="StalkerModLauncher.Views.Controls.ProfileSidebarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:StalkerModLauncher.Resources"
             x:Name="Root"
             Background="Transparent">
    <UserControl.Resources>
        <Style x:Key="TrayProfileListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemChrome"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="0">
                            <Grid ClipToBounds="True">
                                <ContentPresenter Margin="12,8"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <Border x:Name="ActionShade"
                                        Opacity="0"
                                        IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLaunchError}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="#00000000" Offset="0"/>
                                            <GradientStop Color="#00000000" Offset="0.38"/>
                                            <GradientStop Color="#40000000" Offset="0.52"/>
                                            <GradientStop Color="#C0000000" Offset="0.64"/>
                                            <GradientStop Color="#F2000000" Offset="0.78"/>
                                            <GradientStop Color="#F2000000" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel x:Name="ProfileActions"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                             Margin="0,0,7,0"
                                             Opacity="0"
                                             IsHitTestVisible="False">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasLaunchError}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <StackPanel.RenderTransform>
                                        <TranslateTransform X="18"/>
                                    </StackPanel.RenderTransform>
                                    <Button Command="{Binding PrimaryProfileActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource InlineProfileActionButtonStyle}">
                                                <Setter Property="Width" Value="84"/>
                                                <Setter Property="Padding" Value="4,5"/>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static res:Strings.Common_Launch}" FontFamily="Bahnschrift SemiCondensed" FontSize="13"/>
                                            <Viewbox Width="14" Height="14" Margin="4,0,0,0">
                                                <Canvas Width="16" Height="16">
                                                    <Path Data="M4,2 L14,8 L4,14 Z" Fill="{DynamicResource AccentBrush}"/>
                                                </Canvas>
                                            </Viewbox>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActionShade"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ProfileActions"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetName="ProfileActions"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ProfileActions"
                                                                        Storyboard.TargetProperty="IsHitTestVisible">
                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0.08" Value="True"/>
                                        </BooleanAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ActionShade"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetName="ProfileActions"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.16"/>
                                        <DoubleAnimation Storyboard.TargetName="ProfileActions"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         To="18" Duration="0:0:0.20">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseIn"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <BooleanAnimationUsingKeyFrames Storyboard.TargetName="ProfileActions"
                                                                        Storyboard.TargetProperty="IsHitTestVisible">
                                            <DiscreteBooleanKeyFrame KeyTime="0:0:0.16" Value="False"/>
                                        </BooleanAnimationUsingKeyFrames>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource StrokeBrush}"
            BorderThickness="1"
            CornerRadius="6"
            ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="12,12,12,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.Profile_Profiles}"
                           FontSize="18"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           ToolTipService.InitialShowDelay="700"
                           ToolTipService.ShowDuration="5000">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                            <Setter Property="ToolTip" Value="{x:Static res:Strings.Profile_ReorderTooltip}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTrayMode, ElementName=Root}" Value="True">
                                    <Setter Property="ToolTip" Value="{x:Null}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTrayMode, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Button Command="{Binding NewProfileCommand}"
                            Style="{DynamicResource ProfileHeaderIconButtonStyle}"
                            ToolTip="{x:Static res:Strings.Profile_CreateTooltip}"
                            Margin="0,0,3,0">
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Data="M11,13 V16 C11,16.283 11.096,16.521 11.288,16.713 C11.48,16.905 11.717,17.001 12,17 C12.283,16.999 12.52,16.903 12.713,16.712 C12.906,16.521 13.001,16.283 13,16 V13 H16 C16.283,13 16.521,12.904 16.713,12.712 C16.905,12.52 17.001,12.283 17,12 C16.999,11.717 16.903,11.48 16.712,11.288 C16.521,11.096 16.283,11 16,11 H13 V8 C13,7.717 12.904,7.479 12.712,7.288 C12.52,7.097 12.283,7.001 12,7 C11.717,6.999 11.48,7.095 11.288,7.288 C11.096,7.481 11,7.718 11,8 V11 H8 C7.717,11 7.479,11.096 7.288,11.288 C7.097,11.48 7.001,11.717 7,12 C6.999,12.283 7.095,12.52 7.288,12.713 C7.481,12.906 7.718,13.001 8,13 Z M5,21 C4.45,21 3.979,20.804 3.588,20.413 C3.197,20.022 3.001,19.551 3,19 V5 C3,4.45 3.196,3.979 3.588,3.588 C3.98,3.197 4.451,3.001 5,3 H19 C19.55,3 20.021,3.196 20.413,3.588 C20.805,3.98 21.001,4.451 21,5 V19 C21,19.55 20.804,20.021 20.413,20.413 C20.022,20.805 19.551,21.001 19,21 Z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button Command="{Binding ImportMo2CollectionCommand}"
                            Style="{DynamicResource ProfileHeaderIconButtonStyle}"
                            ToolTip="{x:Static res:Strings.Profile_Mo2ImportTooltip}"
                            Margin="0,0,3,0">
                        <TextBlock Text="MO2" FontSize="10" FontWeight="Bold"/>
                    </Button>
                    <Button Command="{Binding ImportProfileCommand}"
                            Style="{DynamicResource ProfileHeaderIconButtonStyle}"
                            ToolTip="{x:Static res:Strings.Profile_ImportTooltip}">
                        <Viewbox Width="26" Height="26">
                            <Canvas Width="24" Height="24">
                                <Rectangle Canvas.Left="4"
                                           Canvas.Top="3"
                                           Width="16"
                                           Height="18"
                                           RadiusX="3"
                                           RadiusY="3"
                                           Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           StrokeThickness="1.7"/>
                                <Path Data="M12,6 V15 M8.5,11.5 L12,15 L15.5,11.5 M8,18 H16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.7"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1"
                  Background="{DynamicResource FieldBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ListBox x:Name="ProfilesList"
                         ItemsSource="{Binding Profiles}"
                         BorderThickness="0"
                         AllowDrop="True"
                         PreviewMouseLeftButtonDown="ProfilesList_OnPreviewMouseLeftButtonDown"
                         MouseMove="ProfilesList_OnMouseMove"
                         DragOver="ProfilesList_OnDragOver"
                         DragLeave="ProfilesList_OnDragLeave"
                         Drop="ProfilesList_OnDrop"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.Style>
                        <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Setter Property="SelectedItem" Value="{Binding SelectedProfile}"/>
                            <Setter Property="ItemContainerStyle" Value="{DynamicResource ProfileListBoxItemStyle}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProfiles}" Value="False">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsTrayMode, ElementName=Root}" Value="True">
                                    <Setter Property="SelectedItem" Value="{x:Null}"/>
                                    <Setter Property="ItemContainerStyle" Value="{StaticResource TrayProfileListBoxItemStyle}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid Width="17"
                                      Height="17"
                                      HorizontalAlignment="Center"
                                      VerticalAlignment="Top"
                                      Margin="0,0,6,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="ToolTip" Value="{x:Static res:Strings.Profile_RegularTooltip}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsStandalone}" Value="True">
                                                    <Setter Property="ToolTip" Value="{x:Static res:Strings.Profile_Standalone}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Canvas Width="15"
                                            Height="15"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Canvas.RenderTransform>
                                            <ScaleTransform ScaleX="1.1"
                                                            ScaleY="1.1"/>
                                        </Canvas.RenderTransform>
                                        <Canvas.Style>
                                            <Style TargetType="Canvas">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStandalone}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Canvas.Style>
                                        <Path Data="M7.5,2 L13,5.2 L7.5,8.4 L2,5.2 Z"
                                              Fill="#282D1F"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.1"
                                              StrokeLineJoin="Round"/>
                                        <Path Data="M2.5,7.7 L7.5,10.7 L12.5,7.7"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.1"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                        <Path Data="M2.5,10.3 L7.5,13.3 L12.5,10.3"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.1"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Canvas>
                                    <Canvas Width="15"
                                            Height="15"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RenderTransformOrigin="0.5,0.5">
                                        <Canvas.RenderTransform>
                                            <ScaleTransform ScaleX="1.1"
                                                            ScaleY="1.1"/>
                                        </Canvas.RenderTransform>
                                        <Canvas.Style>
                                            <Style TargetType="Canvas">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsStandalone}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Canvas.Style>
                                        <Path Data="M3,5 L7.5,2.7 L12,5 L7.5,7.3 Z"
                                              Fill="#2E301F"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.1"
                                              StrokeLineJoin="Round"/>
                                        <Path Data="M3,5 V10.6 L7.5,13.3 L12,10.6 V5 M7.5,7.3 V13.3"
                                              Stroke="{DynamicResource AccentBrush}"
                                              StrokeThickness="1.1"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   LineHeight="17">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="MaxHeight" Value="51"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTrayMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                                            <Setter Property="MaxHeight" Value="34"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <Border Grid.Column="1"
                                                Width="16"
                                                Height="16"
                                                Margin="6,0,0,0"
                                                Background="{DynamicResource DangerBrush}"
                                                CornerRadius="8"
                                                ToolTip="{Binding LaunchErrorSummary}">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding HasLaunchError}" Value="True"/>
                                                                <Condition Binding="{Binding IsTrayMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True"/>
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="!"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource PanelBrush}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{x:Static res:Strings.Profile_Running}"
                                               FontSize="10"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold"
                                               Margin="0,-1,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid Grid.Row="0"
                      Margin="16"
                      VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasProfiles}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Main_NoProfiles}"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,0,0,6"/>
                        <TextBlock Text="{x:Static res:Strings.Profile_EmptyFirstHint}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0"/>
                    </StackPanel>
                </Grid>

                <Button Grid.Row="1"
                        Content="{x:Static res:Strings.Profile_ModBrowser}"
                        Click="ModCatalogButton_OnClick"
                        Margin="12,12,12,12"
                        Padding="6,4">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTrayMode, ElementName=Root}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>

            <Grid Grid.Row="2" Margin="12,10,12,12">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTrayMode, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="38"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Width="32"
                        Height="32"
                        Padding="0"
                        HorizontalAlignment="Left"
                        Click="LauncherSettingsButton_OnClick"
                        >
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               FontSize="16"
                               Text="&#xE713;"/>
                </Button>
                <Button Grid.Column="1"
                        Content="{Binding ActivityLog.ToggleText}"
                        Command="{Binding ActivityLog.ToggleCommand}"
                        Padding="6,4"/>
            </Grid>
            <Button Grid.Row="2"
                    Content="{x:Static res:Strings.Main_OpenLauncher}"
                    Click="OpenLauncherButton_OnClick"
                    Margin="12,10,12,12"
                    Padding="6,4">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsTrayMode, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Border>
</UserControl>
