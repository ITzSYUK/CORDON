<UserControl x:Class="StalkerModLauncher.Views.Controls.ProfileImportContentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:StalkerModLauncher.Views.Controls"
             xmlns:res="clr-namespace:StalkerModLauncher.Resources"
             Foreground="{DynamicResource TextBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CORDON;component/Themes/Palette.xaml"/>
                <ResourceDictionary Source="/CORDON;component/Themes/SharedStyles.xaml"/>
                <ResourceDictionary Source="/CORDON;component/Themes/Mo2ImportStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="OptionalMessageStyle" TargetType="TextBlock">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="">
                        <Setter Property="Visibility" Value="Collapsed"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid x:Name="RootGrid" Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="ActionsPanel" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{x:Static res:Strings.Common_Cancel}" Click="CancelButton_OnClick" Margin="0,0,6,0"/>
                <Button x:Name="ImportButton" Content="{x:Static res:Strings.Mo2_CreateProfile}" Command="{Binding ImportCommand}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding ImportBlockedReason}" Style="{DynamicResource PrimaryButtonStyle}"/>
            </StackPanel>
        </Grid>
        <Border x:Name="PreviewBorder" Grid.Row="1" Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Static res:Strings.ProfileImport_Name}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="ProfileNameTextBox" Grid.Column="1" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"/>
                    <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Common_BaseGame}" VerticalAlignment="Center" Margin="16,0,10,0"/>
                    <TextBox x:Name="GamePathTextBox" Grid.Column="3" Text="{Binding GamePath, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding GamePath}"/>
                    <Button Grid.Column="4" Content="{x:Static res:Strings.Common_Change}" Command="{Binding BrowseGameCommand}" Margin="6,0,0,0"/>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,0,0,8">
                    <TextBlock Text="{Binding GamePathStatus}" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBlock Text="{Binding Summary}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding ExecutableSummary}" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutableSummary}"/>
                    <TextBlock Text="{Binding ImportBlockedReason}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Style="{StaticResource OptionalMessageStyle}"/>
                    <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" Style="{StaticResource OptionalMessageStyle}"/>
                </StackPanel>
                <controls:ModImportListView x:Name="ModList" Grid.Row="2" IsProfileImport="True"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
