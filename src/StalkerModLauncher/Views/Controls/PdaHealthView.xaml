<UserControl x:Class="StalkerModLauncher.Views.Controls.PdaHealthView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:StalkerModLauncher.Resources"
             xmlns:themes="clr-namespace:StalkerModLauncher.Themes"
             xmlns:infrastructure="clr-namespace:StalkerModLauncher.Infrastructure"
             Background="{DynamicResource PdaPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{x:Static themes:PdaThemeSelector.CurrentSource}"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource PdaInsetPanelBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="9" Margin="0,0,0,8"
                Visibility="{Binding ShowStoragePanel, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding StoragePanelTitle}" FontWeight="SemiBold" FontSize="14" ToolTip="{Binding StoragePanelToolTip}"/>
                    <TextBlock Text="{Binding StorageStateDisplay}" Foreground="#858E7D" FontSize="10" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <UniformGrid Grid.Column="1" Columns="3" Margin="14,0">
                    <StackPanel><TextBlock Text="{Binding FirstMetricTitle}" Foreground="#858E7D" FontSize="10"/><TextBlock Text="{Binding FirstMetricValue}" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel><TextBlock Text="{Binding SecondMetricTitle}" Foreground="#858E7D" FontSize="10"/><TextBlock Text="{Binding SecondMetricValue}" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel><TextBlock Text="{Binding ThirdMetricTitle}" Foreground="#858E7D" FontSize="10"/><TextBlock Text="{Binding ThirdMetricValue}" FontWeight="SemiBold"/></StackPanel>
                </UniformGrid>
                <WrapPanel Grid.Column="2">
                    <Button Content="{x:Static res:Strings.Health_RebuildWorkspace}" Command="{Binding RebuildWorkspaceCommand}" Margin="0,0,5,0"
                            Visibility="{Binding UsesLinkedWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <Button Content="{x:Static res:Strings.Health_MoveWorkspace}" Command="{Binding MoveWorkspaceCommand}"/>
                </WrapPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource PdaDeepFieldBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="9">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="{Binding Summary}" FontFamily="Bahnschrift SemiCondensed" FontSize="15" Foreground="#E4DFC9"/>
                <ListBox Grid.Row="1" ItemsSource="{Binding Checks}" BorderThickness="0" Background="Transparent" Margin="0,5,0,0"
                         infrastructure:SmoothScrollBehavior.IsEnabled="True" ScrollViewer.CanContentScroll="False">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,3">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Ellipse Width="7" Height="7" VerticalAlignment="Top" Margin="0,6,0,0">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#8FAE55"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                    <Setter Property="Fill" Value="#CF962C"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                    <Setter Property="Fill" Value="#AD5848"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Margin="6,0,10,0" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Text="{Binding Details}" Foreground="#9AA18F" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
        <WrapPanel Grid.Row="2" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="{x:Static res:Strings.Common_Refresh}" Command="{Binding RefreshCommand}" Margin="0,0,5,0"/>
                <Button Content="{x:Static res:Strings.Common_Profile}" Command="{Binding OpenProfileCommand}" Margin="0,0,5,0"/>
                <Button Content="{x:Static res:Strings.Health_Saves}" Command="{Binding OpenSavesCommand}" Margin="0,0,5,0"/>
                <Button Content="{x:Static res:Strings.Health_LatestLog}" Command="{Binding OpenLatestLogCommand}" Margin="0,0,5,0"/>
                <Button Content="{x:Static res:Strings.Check_CrashDump}" Command="{Binding OpenCrashDumpCommand}" Margin="0,0,5,0"/>
                <Button Content="{x:Static res:Strings.Health_CopyReport}" Command="{Binding CopyReportCommand}"/>
        </WrapPanel>
    </Grid>
</UserControl>
