<UserControl x:Class="StalkerModLauncher.Views.Controls.LauncherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:StalkerModLauncher.Models"
             FontSize="12"
             Background="Transparent">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="SettingsBooleanToVisibilityConverter"/>
        <Style x:Key="SettingsRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Grid Width="15" Height="15">
                                    <Ellipse x:Name="OuterCircle" Fill="{DynamicResource FieldBackgroundBrush}"
                                             Stroke="{DynamicResource MutedTextBrush}"/>
                                    <Ellipse x:Name="InnerCircle" Width="7" Height="7"
                                             Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image x:Name="StateImage" Source="{DynamicResource RadiationOffImage}"
                                   Width="20" Height="20" Stretch="Uniform" Margin="0,0,6,0"/>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="StateImage" Property="Source" Value="{DynamicResource RadiationOnImage}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#3A3325"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                            <Grid>
                                                <ContentPresenter Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  VerticalAlignment="Center"/>
                                                <Path Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource MutedTextBrush}"
                                                      Width="8" Height="4" HorizontalAlignment="Right"
                                                      VerticalAlignment="Center" Margin="0,0,10,0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        Background="{DynamicResource FieldBackgroundBrush}"
                                        BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="1">
                                    <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                        <StackPanel IsItemsHost="True"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="SettingsPanelBorder"
                Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1" CornerRadius="{DynamicResource LauncherSettingsPanelCornerRadius}" Padding="18,16,8,16">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="ИНТЕРФЕЙС" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,10"/>
                        <WrapPanel Margin="0,0,0,15">
                            <RadioButton Content="Classic UI" Style="{StaticResource SettingsRadioButtonStyle}"
                                         GroupName="LauncherInterface" IsChecked="{Binding UseClassicInterface}" Margin="0,0,22,0"/>
                            <RadioButton Content="PDA UI" Style="{StaticResource SettingsRadioButtonStyle}"
                                         GroupName="LauncherInterface" IsChecked="{Binding UsePdaInterface}" Margin="0,0,22,0"/>
                            <RadioButton Content="PDA UI 2" Style="{StaticResource SettingsRadioButtonStyle}"
                                         GroupName="LauncherInterface" IsChecked="{Binding UseNewPdaInterface}"/>
                        </WrapPanel>
                        <CheckBox Content="Запускать вместе с Windows" Style="{StaticResource SettingsCheckBoxStyle}"
                                  IsChecked="{Binding StartWithWindows}" Margin="0,0,0,9"/>
                        <CheckBox Content="При запуске вместе с Windows открывать в трее"
                                  Style="{StaticResource SettingsCheckBoxStyle}"
                                  IsChecked="{Binding StartMinimizedToTrayOnWindowsStartup}"
                                  IsEnabled="{Binding CanStartMinimizedToTray}"
                                  Margin="26,0,0,9"/>
                        <CheckBox Content="Показывать значок в трее" Style="{StaticResource SettingsCheckBoxStyle}"
                                  IsChecked="{Binding ShowTrayIcon}" Margin="0,0,0,9"/>
                        <CheckBox Content="Сворачивать в трей вместо закрытия" Style="{StaticResource SettingsCheckBoxStyle}"
                                  IsChecked="{Binding MinimizeToTrayOnClose}"
                                  IsEnabled="{Binding CanUseTray}"
                                  Margin="26,0,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1" Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,18"/>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="ЖУРНАЛИРОВАНИЕ" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                                <TextBlock Text="Уровень записи launcher.log" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                                <ComboBox Style="{StaticResource SettingsComboBoxStyle}"
                                          SelectedValue="{Binding LogLevel}" SelectedValuePath="Tag">
                                    <ComboBoxItem Content="Только ошибки" Tag="{x:Static models:LauncherLogLevel.ErrorsOnly}"/>
                                    <ComboBoxItem Content="Обычный" Tag="{x:Static models:LauncherLogLevel.Standard}"/>
                                    <ComboBoxItem Content="Подробный" Tag="{x:Static models:LauncherLogLevel.Detailed}"/>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <TextBlock Text="{Binding StorageDescription}" Foreground="{DynamicResource MutedTextBrush}"
                                           FontSize="11" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <TextBlock Text="Настройки" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource FieldBackgroundBrush}"
                                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                            CornerRadius="4" Padding="10,7" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding SettingsDirectory}" Foreground="{DynamicResource MutedTextBrush}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center"/>
                                    </Border>
                                    <Button Grid.Column="1" Content="Открыть" Command="{Binding OpenSettingsFolderCommand}" MinWidth="82"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                        <TextBlock Grid.Row="1"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11.5"
                                   Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Ошибки и основные действия лаунчера."/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LogLevel}" Value="{x:Static models:LauncherLogLevel.ErrorsOnly}">
                                            <Setter Property="Text" Value="Ошибки запуска и сбои лаунчера."/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding LogLevel}" Value="{x:Static models:LauncherLogLevel.Detailed}">
                                            <Setter Property="Text" Value="Обычные записи и техническая диагностика запуска, Workspace и USVFS."/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <Border Grid.Row="3" Height="1" Background="{DynamicResource StrokeBrush}" Margin="0,18"/>

                    <StackPanel Grid.Row="4">
                        <TextBlock Text="ОБНОВЛЕНИЕ" FontSize="16" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}" Margin="0,0,0,12"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Проверить обновления"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    MinWidth="155"/>
                            <Button x:Name="OpenReleaseButton"
                                    Content="Открыть релиз"
                                    Command="{Binding OpenReleaseCommand}"
                                    Margin="8,0,0,0"
                                    Opacity="0"
                                    Visibility="{Binding HasAvailableUpdate, Converter={StaticResource SettingsBooleanToVisibilityConverter}}"/>
                            <Grid Margin="8,0,0,0">
                                <Button x:Name="DownloadToDownloadsButton"
                                        Content="Скачать в Загрузки"
                                        Click="DownloadToDownloadsButton_OnClick"
                                        Opacity="0"
                                        Visibility="{Binding CanShowDownloadButton, Converter={StaticResource SettingsBooleanToVisibilityConverter}}"/>
                                <StackPanel x:Name="DownloadOptionsPanel"
                                            Orientation="Horizontal"
                                            Opacity="0"
                                            Visibility="{Binding AreDownloadOptionsVisible, Converter={StaticResource SettingsBooleanToVisibilityConverter}}">
                                    <Button Content="Minimal version"
                                            Command="{Binding DownloadMinimalCommand}"/>
                                    <Button Content="Standalone version"
                                            Command="{Binding DownloadStandaloneCommand}"
                                            Margin="8,0,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                        <CheckBox Content="Автоматически проверять обновления при запуске"
                                      Style="{StaticResource SettingsCheckBoxStyle}"
                                      IsChecked="{Binding AutoCheckForUpdates}"
                                      Margin="0,0,0,9"/>
                        <CheckBox Content="Показывать системное уведомление о доступном обновлении"
                                      Style="{StaticResource SettingsCheckBoxStyle}"
                                      IsChecked="{Binding ShowUpdateNotifications}"
                                      IsEnabled="{Binding AutoCheckForUpdates}"/>
                        <TextBlock Text="{Binding UpdateStatus}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,10,0,0"/>
                        <Button Content="Открыть Загрузки"
                                Command="{Binding OpenDownloadsCommand}"
                                HorizontalAlignment="Left"
                                Margin="0,8,0,0"
                                Visibility="{Binding HasDownloadedRelease, Converter={StaticResource SettingsBooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Button Content="Сбросить настройки"
                    Command="{Binding ResetCommand}"
                    HorizontalAlignment="Left"
                    MinWidth="150"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Click="CancelButton_OnClick" MinWidth="100" Margin="0,0,8,0"/>
                <Button Content="Сохранить" Click="SaveButton_OnClick"
                        Style="{DynamicResource PrimaryButtonStyle}" MinWidth="110"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
