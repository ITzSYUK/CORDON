<UserControl x:Class="StalkerModLauncher.Views.Controls.LauncherSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:StalkerModLauncher.Models"
             xmlns:res="clr-namespace:StalkerModLauncher.Resources"
             FontSize="12"
             Background="{DynamicResource LauncherSettingsPageBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CORDON;component/Themes/ProfileSettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="SettingsBooleanToVisibilityConverter"/>

            <Style x:Key="LauncherSettingsCardStyle" TargetType="Border" BasedOn="{StaticResource ProfileSettingPanelStyle}">
                <Setter Property="Background" Value="{DynamicResource LauncherSettingsCardBrush}"/>
            </Style>

            <Style x:Key="SettingsRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <BulletDecorator Background="Transparent">
                                <BulletDecorator.Bullet>
                                    <Grid Width="15" Height="15">
                                        <Ellipse x:Name="OuterCircle" Fill="{DynamicResource FieldBackgroundBrush}"
                                                 Stroke="{DynamicResource MutedTextBrush}"/>
                                        <Ellipse x:Name="InnerCircle" Width="7" Height="7"
                                                 Fill="{DynamicResource AccentBrush}" Visibility="Collapsed"/>
                                    </Grid>
                                </BulletDecorator.Bullet>
                                <ContentPresenter Margin="5,0,0,0" VerticalAlignment="Center"/>
                            </BulletDecorator>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="OuterCircle" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="OuterCircle" Property="Stroke" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsComboBoxItemStyle" TargetType="ComboBoxItem">
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBoxItem">
                            <Border x:Name="Chrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource PanelAltBrush}"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ModSelectionBrush}"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SettingsComboBoxStyle" TargetType="ComboBox">
                <Setter Property="Background" Value="{DynamicResource FieldBackgroundBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource StrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="10,5"/>
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="ItemContainerStyle" Value="{StaticResource SettingsComboBoxItemStyle}"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ComboBox">
                            <Grid>
                                <ToggleButton Background="{TemplateBinding Background}"
                                              BorderBrush="{TemplateBinding BorderBrush}"
                                              BorderThickness="{TemplateBinding BorderThickness}"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                                                <Grid>
                                                    <ContentPresenter Margin="{Binding Padding, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                      Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                      ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                      VerticalAlignment="Center"/>
                                                    <Path Data="M0,0 L4,4 L8,0 Z" Fill="{DynamicResource MutedTextBrush}"
                                                          Width="8" Height="4" HorizontalAlignment="Right"
                                                          VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                       Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                            Background="{DynamicResource FieldBackgroundBrush}"
                                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" Padding="1">
                                        <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                                            <StackPanel IsItemsHost="True"/>
                                        </ScrollViewer>
                                    </Border>
                                </Popup>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border x:Name="SettingsPanelBorder"
                Background="{DynamicResource LauncherSettingsPageBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="{DynamicResource LauncherSettingsPanelCornerRadius}"
                Padding="14">
            <TabControl x:Name="SettingsTabs" TabStripPlacement="Left">
                <TabItem Header="{x:Static res:Strings.Settings_InterfaceHeading}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource LauncherSettingsCardStyle}">
                                <WrapPanel>
                                    <RadioButton Content="{x:Static res:Strings.Settings_ClassicUi}"
                                                 Style="{StaticResource SettingsRadioButtonStyle}"
                                                 GroupName="LauncherInterface" IsChecked="{Binding UseClassicInterface}" Margin="0,0,22,0"/>
                                    <RadioButton Content="{x:Static res:Strings.Settings_PdaUi}"
                                                 Style="{StaticResource SettingsRadioButtonStyle}"
                                                 GroupName="LauncherInterface" IsChecked="{Binding UsePdaInterface}" Margin="0,0,22,0"/>
                                    <RadioButton Content="{x:Static res:Strings.Settings_PdaUi2}"
                                                 Style="{StaticResource SettingsRadioButtonStyle}"
                                                 GroupName="LauncherInterface" IsChecked="{Binding UseNewPdaInterface}"/>
                                </WrapPanel>
                            </Border>

                            <Border Style="{StaticResource LauncherSettingsCardStyle}">
                                <StackPanel>
                                    <Label Content="{x:Static res:Strings.Settings_LanguageLabel}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Target="{Binding ElementName=LanguageSelector}" Padding="0,0,0,4"/>
                                    <ComboBox x:Name="LanguageSelector" Width="180" HorizontalAlignment="Left"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              SelectedValue="{Binding UiLanguage}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{x:Static res:Strings.Settings_LanguageSystem}" Tag="system"/>
                                        <ComboBoxItem Content="{x:Static res:Strings.Settings_LanguageRussian}" Tag="ru"/>
                                        <ComboBoxItem Content="{x:Static res:Strings.Settings_LanguageEnglish}" Tag="en"/>
                                    </ComboBox>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource LauncherSettingsCardStyle}">
                                <StackPanel>
                                    <CheckBox Content="{x:Static res:Strings.Settings_StartWithWindows}"
                                              Style="{StaticResource ProfileStandaloneCheckBoxStyle}"
                                              IsChecked="{Binding StartWithWindows}" Margin="0,0,0,8"/>
                                    <CheckBox Content="{x:Static res:Strings.Settings_StartMinimized}"
                                              Style="{StaticResource ProfileStandaloneCheckBoxStyle}"
                                              IsChecked="{Binding StartMinimizedToTrayOnWindowsStartup}"
                                              IsEnabled="{Binding CanStartMinimizedToTray}" Margin="26,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource LauncherSettingsCardStyle}">
                                <StackPanel>
                                    <CheckBox Content="{x:Static res:Strings.Settings_ShowTrayIcon}"
                                              Style="{StaticResource ProfileStandaloneCheckBoxStyle}"
                                              IsChecked="{Binding ShowTrayIcon}" Margin="0,0,0,8"/>
                                    <CheckBox Content="{x:Static res:Strings.Settings_MinimizeToTray}"
                                              Style="{StaticResource ProfileStandaloneCheckBoxStyle}"
                                              IsChecked="{Binding MinimizeToTrayOnClose}"
                                              IsEnabled="{Binding CanUseTray}" Margin="26,0,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.Settings_DataHeading}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource LauncherSettingsCardStyle}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:Strings.Settings_StorageLabel}"
                                               Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource FieldBackgroundBrush}"
                                                BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                                CornerRadius="4" Padding="10,7" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding SettingsDirectory}" ToolTip="{Binding SettingsDirectory}"
                                                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                        <Button Grid.Column="1" Content="{x:Static res:Strings.Common_Open}"
                                                Command="{Binding OpenSettingsFolderCommand}" MinWidth="96"/>
                                    </Grid>
                                    <TextBlock Text="{Binding StorageDescription}" Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource LauncherSettingsCardStyle}">
                                <Button Content="{x:Static res:Strings.Settings_MigrationWizard}"
                                        Command="{Binding OpenMigrationWizardCommand}" HorizontalAlignment="Left"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.Settings_LoggingHeading}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource LauncherSettingsCardStyle}">
                                <StackPanel>
                                    <Label Content="{x:Static res:Strings.Settings_LogLevelLabel}"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           Target="{Binding ElementName=LogLevelSelector}" Padding="0,0,0,4"/>
                                    <ComboBox x:Name="LogLevelSelector" Width="230" HorizontalAlignment="Left"
                                              Style="{StaticResource SettingsComboBoxStyle}"
                                              SelectedValue="{Binding LogLevel}" SelectedValuePath="Tag">
                                        <ComboBoxItem Content="{x:Static res:Strings.Settings_LogLevelErrors}" Tag="{x:Static models:LauncherLogLevel.ErrorsOnly}"/>
                                        <ComboBoxItem Content="{x:Static res:Strings.Settings_LogLevelStandard}" Tag="{x:Static models:LauncherLogLevel.Standard}"/>
                                        <ComboBoxItem Content="{x:Static res:Strings.Settings_LogLevelDetailed}" Tag="{x:Static models:LauncherLogLevel.Detailed}"/>
                                    </ComboBox>
                                    <TextBlock Foreground="{DynamicResource MutedTextBrush}"
                                               FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="{x:Static res:Strings.Settings_LogDescriptionStandard}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding LogLevel}" Value="{x:Static models:LauncherLogLevel.ErrorsOnly}">
                                                        <Setter Property="Text" Value="{x:Static res:Strings.Settings_LogDescriptionErrors}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding LogLevel}" Value="{x:Static models:LauncherLogLevel.Detailed}">
                                                        <Setter Property="Text" Value="{x:Static res:Strings.Settings_LogDescriptionDetailed}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.Settings_UpdateHeading}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border Style="{StaticResource LauncherSettingsCardStyle}">
                                <StackPanel>
                                    <CheckBox Content="{x:Static res:Strings.Settings_AutoCheckUpdates}"
                                              Style="{StaticResource ProfileStandaloneCheckBoxStyle}"
                                              IsChecked="{Binding AutoCheckForUpdates}" Margin="0,0,0,8"/>
                                    <CheckBox Content="{x:Static res:Strings.Settings_ShowUpdateNotifications}"
                                              Style="{StaticResource ProfileStandaloneCheckBoxStyle}"
                                              IsChecked="{Binding ShowUpdateNotifications}"
                                              IsEnabled="{Binding AutoCheckForUpdates}" Margin="26,0,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource LauncherSettingsCardStyle}">
                                <StackPanel>
                                    <WrapPanel>
                                        <Button Content="{x:Static res:Strings.Settings_CheckUpdates}"
                                                Command="{Binding CheckForUpdatesCommand}" Margin="0,0,8,6"/>
                                        <Button x:Name="OpenReleaseButton"
                                                Content="{x:Static res:Strings.Settings_OpenRelease}"
                                                Command="{Binding OpenReleaseCommand}" Margin="0,0,8,6" Opacity="0"
                                                Visibility="{Binding HasAvailableUpdate, Converter={StaticResource SettingsBooleanToVisibilityConverter}}"/>
                                        <Button x:Name="DownloadAndInstallButton"
                                                Content="{x:Static res:Strings.Settings_DownloadAndInstall}"
                                                Command="{Binding DownloadAndInstallCommand}" Margin="0,0,0,6" Opacity="0"
                                                Visibility="{Binding HasAvailableUpdate, Converter={StaticResource SettingsBooleanToVisibilityConverter}}"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding UpdateStatus}" Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"/>
                                    <Button Content="{x:Static res:Strings.Settings_OpenLauncherFolder}"
                                            Command="{Binding OpenDownloadsCommand}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                            Visibility="{Binding HasDownloadedRelease, Converter={StaticResource SettingsBooleanToVisibilityConverter}}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Button Content="{x:Static res:Strings.Settings_Reset}" Command="{Binding ResetCommand}"
                    HorizontalAlignment="Left" MinWidth="150" MinHeight="36"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{x:Static res:Strings.Common_Cancel}" Click="CancelButton_OnClick"
                        MinWidth="100" MinHeight="36" Margin="0,0,8,0"/>
                <Button Content="{x:Static res:Strings.Common_Save}" Click="SaveButton_OnClick"
                        Style="{DynamicResource PrimaryButtonStyle}" MinWidth="110" MinHeight="36"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
