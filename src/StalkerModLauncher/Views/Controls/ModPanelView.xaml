<UserControl x:Class="StalkerModLauncher.Views.Controls.ModPanelView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:StalkerModLauncher.Resources"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="/CORDON;component/Themes/Mo2ImportStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <Style x:Key="ConflictRadiationCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border Width="23" Height="23" Background="Transparent">
                            <Viewbox Width="21" Height="21" Stretch="Uniform"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsHitTestVisible="False">
                                <Canvas Width="123" Height="123">
                                    <Ellipse x:Name="Ring" Width="116" Height="116" Canvas.Left="3.5" Canvas.Top="3.5"
                                             Stroke="#FFC903" StrokeThickness="7"/>
                                    <Path x:Name="LeftBlade" Fill="#FFC903"
                                          Data="M11.53,61.33 C12.46,42.73 20.61,28.16 36.59,17.97 L54.15,48.88 C50,51.21 47.59,55.35 46.95,61.33 Z"/>
                                    <Path x:Name="RightBlade" Fill="#FFC903"
                                          Data="M86.45,17.73 C102.09,27.84 110.64,42.18 111.47,61.11 L75.92,60.86 C75.98,56.1 73.6,51.94 68.74,48.4 Z"/>
                                    <Path x:Name="BottomBlade" Fill="#FFC903"
                                          Data="M86.71,104.87 C70.13,113.36 53.44,113.59 36.63,104.85 L54.62,74.2 C58.71,76.63 63.51,76.65 69.01,74.21 Z"/>
                                    <Ellipse x:Name="Center" Width="20" Height="20" Canvas.Left="51.5" Canvas.Top="52" Fill="#FFC903"/>
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding ConflictKind}" Value="Overwrite">
                                <Setter TargetName="Ring" Property="Stroke" Value="#8FAE55"/>
                                <Setter TargetName="LeftBlade" Property="Fill" Value="#8FAE55"/>
                                <Setter TargetName="RightBlade" Property="Fill" Value="#8FAE55"/>
                                <Setter TargetName="BottomBlade" Property="Fill" Value="#8FAE55"/>
                                <Setter TargetName="Center" Property="Fill" Value="#8FAE55"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ConflictKind}" Value="Overwritten">
                                <Setter TargetName="Ring" Property="Stroke" Value="#D85C4A"/>
                                <Setter TargetName="LeftBlade" Property="Fill" Value="#D85C4A"/>
                                <Setter TargetName="RightBlade" Property="Fill" Value="#D85C4A"/>
                                <Setter TargetName="BottomBlade" Property="Fill" Value="#D85C4A"/>
                                <Setter TargetName="Center" Property="Fill" Value="#D85C4A"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ConflictKind}" Value="Mixed">
                                <Setter TargetName="Ring" Property="Stroke" Value="#D29A39"/>
                                <Setter TargetName="LeftBlade" Property="Fill" Value="#8FAE55"/>
                                <Setter TargetName="RightBlade" Property="Fill" Value="#D85C4A"/>
                                <Setter TargetName="BottomBlade" Property="Fill" Value="#D29A39"/>
                                <Setter TargetName="Center" Property="Fill" Value="#D29A39"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ConflictKind}" Value="Redundant">
                                <Setter TargetName="Ring" Property="Stroke" Value="#7D817A"/>
                                <Setter TargetName="LeftBlade" Property="Fill" Value="#7D817A"/>
                                <Setter TargetName="RightBlade" Property="Fill" Value="#7D817A"/>
                                <Setter TargetName="BottomBlade" Property="Fill" Value="#7D817A"/>
                                <Setter TargetName="Center" Property="Fill" Value="#7D817A"/>
                            </DataTrigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter TargetName="Ring" Property="Stroke" Value="#756A32"/>
                                <Setter TargetName="LeftBlade" Property="Fill" Value="#756A32"/>
                                <Setter TargetName="RightBlade" Property="Fill" Value="#756A32"/>
                                <Setter TargetName="BottomBlade" Property="Fill" Value="#756A32"/>
                                <Setter TargetName="Center" Property="Fill" Value="#756A32"/>
                                <Setter Property="Opacity" Value="0.52"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.3"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UseCompactHeader, ElementName=Root}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="22,0,0,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding UseCompactHeader, ElementName=Root}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{x:Static res:Strings.Mod_Heading}"
                           FontSize="18"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{x:Static res:Strings.Mod_PriorityHint}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11"
                           Margin="0,2,0,0"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <ToggleButton Content="{x:Static res:Strings.Profile_Standalone}"
                              IsChecked="{Binding SelectedProfile.IsStandalone}"
                              IsEnabled="{Binding CanEditSelectedProfile}"
                              Style="{StaticResource ProfileToggleButtonStyle}"
                              Margin="0,0,8,8"
                              Visibility="{Binding ShowStandaloneToggle, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}"
                              ToolTipService.InitialShowDelay="600"
                              ToolTipService.BetweenShowDelay="0">
                    <ToggleButton.ToolTip>
                        <ToolTip>
                            <TextBlock Text="{x:Static res:Strings.Profile_StandaloneTooltip}" TextWrapping="Wrap" MaxWidth="260"/>
                        </ToolTip>
                    </ToggleButton.ToolTip>
                </ToggleButton>
                <Button Command="{Binding ScanForModsCommand}"
                        Style="{StaticResource ModToolbarIconButtonStyle}"
                        ToolTip="{x:Static res:Strings.Mod_ScanFolderTooltip}"
                        ToolTipService.InitialShowDelay="600"
                        ToolTipService.BetweenShowDelay="0"
                        Margin="0,0,8,8">
                    <Viewbox Width="26" Height="26">
                        <Canvas Width="24" Height="24">
                            <Path Data="M4,5.5 C4,4.672 4.672,4 5.5,4 H10 L12,6 H18.5 C19.328,6 20,6.672 20,7.5 V10"
                                  Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                            <Path Data="M11.4,19.5 H5.5 C4.672,19.5 4,18.828 4,18 V8"
                                  Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                            <Ellipse Canvas.Left="12"
                                     Canvas.Top="11"
                                     Width="7"
                                     Height="7"
                                     Stroke="{StaticResource AccentBrush}"
                                     StrokeThickness="1.7"/>
                            <Path Data="M17.5,16.5 L21,20"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Command="{Binding InstallModArchiveCommand}"
                        Style="{StaticResource ModToolbarIconButtonStyle}"
                        ToolTip="{x:Static res:Strings.Mod_InstallArchiveTooltip}"
                        ToolTipService.InitialShowDelay="600"
                        ToolTipService.BetweenShowDelay="0"
                        Margin="0,0,8,8">
                    <Grid Width="26" Height="26">
                        <Path Data="M5,3.5 H14 L19,8.5 V20.5 H5 Z M14,3.5 V8.5 H19"
                              Stroke="{StaticResource TextBrush}" StrokeThickness="1.6"
                              StrokeLineJoin="Round"/>
                        <TextBlock Text="ZIP" Foreground="{StaticResource AccentBrush}"
                                   FontSize="7" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </Grid>
                </Button>
                <Button Command="{Binding AddModCommand}"
                        Style="{StaticResource ModToolbarIconButtonStyle}"
                        ToolTip="{x:Static res:Strings.Mod_AddFolderTooltip}"
                        ToolTipService.InitialShowDelay="600"
                        ToolTipService.BetweenShowDelay="0"
                        Margin="0,0,8,8">
                    <Viewbox Width="26" Height="26">
                        <Canvas Width="24" Height="24">
                            <Path Data="M4,18 V6.5 C4,5.672 4.672,5 5.5,5 H10 L12,7 H18.5 C19.328,7 20,7.672 20,8.5 V18 C20,18.828 19.328,19.5 18.5,19.5 H5.5 C4.672,19.5 4,18.828 4,18 Z"
                                  Stroke="{StaticResource TextBrush}"
                                  StrokeThickness="1.7"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"/>
                            <Path Data="M12,10 V16 M9,13 H15"
                                  Stroke="{StaticResource AccentBrush}"
                                  StrokeThickness="1.8"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource FieldBackgroundBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                >
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Margin" Value="0,12,0,0"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding UseCompactHeader, ElementName=Root}" Value="True">
                            <Setter Property="Margin" Value="0"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="215"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox x:Name="ModSearchBox"
                                 Text="{Binding ModSearchText, UpdateSourceTrigger=PropertyChanged}"/>
                        <Border BorderThickness="{Binding BorderThickness, ElementName=ModSearchBox}"
                                Padding="{Binding Padding, ElementName=ModSearchBox}"
                                Background="Transparent"
                                IsHitTestVisible="False">
                            <TextBlock Text="{x:Static res:Strings.Mod_SearchWatermark}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=ModSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Text, ElementName=ModSearchBox}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>
                    <ComboBox Grid.Column="1" Margin="7,0,0,0" ItemsSource="{Binding ModFilterOptions}"
                              SelectedValue="{Binding SelectedModFilter}" SelectedValuePath="Value" DisplayMemberPath="Name"
                              Style="{StaticResource Mo2ComboBoxStyle}"/>
                    <Button Grid.Column="2" Margin="7,0,0,0" Content="{x:Static res:Strings.Mod_Conflicts}"
                            Command="{Binding ShowSelectedModConflictsCommand}" ToolTip="{x:Static res:Strings.Mod_SelectedDetailsTooltip}"
                            ToolTipService.InitialShowDelay="600" ToolTipService.BetweenShowDelay="0"/>
                </Grid>
            <ListView x:Name="ModsList"
                      Grid.Row="1"
                      Margin="0"
                      Background="Transparent"
                      BorderThickness="0"
                      FocusVisualStyle="{x:Null}"
                      SizeChanged="ModsList_SizeChanged"
                      ItemsSource="{Binding FilteredMods}"
                      SelectedItem="{Binding SelectedMod}"
                      SelectionMode="Extended"
                      ItemContainerStyle="{DynamicResource ModListViewItemStyle}"
                      AllowDrop="True"
                      Drop="ModsList_OnDrop"
                      DragOver="ModsList_OnDragOver"
                      DragLeave="ModsList_OnDragLeave"
                      PreviewMouseLeftButtonDown="ModsList_OnPreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="ModsList_OnPreviewMouseLeftButtonUp"
                      PreviewMouseRightButtonDown="ModsList_OnPreviewMouseRightButtonDown"
                      MouseDoubleClick="ModsList_OnMouseDoubleClick"
                      MouseMove="ModsList_OnMouseMove"
                      ToolTip="{x:Static res:Strings.Mod_DragTooltip}"
                      ToolTipService.InitialShowDelay="600"
                      ToolTipService.BetweenShowDelay="0"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn Header="#" Width="36" DisplayMemberBinding="{Binding Order}"/>
                        <GridViewColumn Header="{x:Static res:Strings.Mod_Enabled}" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsEnabled, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ConflictRadiationCheckBoxStyle}"
                                              IsEnabled="{Binding DataContext.CanEditSelectedProfile, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              HorizontalAlignment="Center"
                                              HorizontalContentAlignment="Center"
                                              ToolTip="{Binding OverlayDetails}"
                                              ToolTipService.ShowOnDisabled="True"
                                              ToolTipService.InitialShowDelay="600"
                                              ToolTipService.BetweenShowDelay="0">
                                    </CheckBox>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{x:Static res:Strings.Common_Mod}" Width="220">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding GroupName, StringFormat={x:Static res:Strings.Mod_GroupFormat}}"
                                                   Foreground="{StaticResource MutedTextBrush}"
                                                   FontSize="10"
                                                   TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding GroupName}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="{x:Static res:Strings.Common_Folder}">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

                <Border Grid.Row="2"
                        Margin="0,8,0,0">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ModArchiveProgressPanelStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsInstallingModArchive}" Value="True"/>
                                        <Condition Binding="{Binding IsModArchiveInstallDestinationConflict}" Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{Binding ModArchiveInstallProgressText}"
                                   Foreground="{DynamicResource TextBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                        <ProgressBar Value="{Binding ModArchiveInstallProgress, Mode=OneWay}"
                                     IsIndeterminate="{Binding IsModArchiveInstallProgressIndeterminate}"
                                     Style="{DynamicResource ModArchiveProgressBarStyle}"
                                     Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Style="{DynamicResource ModArchiveProgressPanelStyle}"
                        Margin="0,8,0,0"
                        Visibility="{Binding IsModArchiveInstallDestinationConflict, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="{x:Static res:Strings.Mod_ArchiveConflictHeading}"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ModArchiveInstallDestinationConflictText}"
                                   Foreground="{DynamicResource TextBrush}"
                                   Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding ModArchiveInstallDestinationConflictAction}"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   Margin="0,2,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                            <Button Content="{x:Static res:Strings.Mod_InstallInNewFolder}"
                                    Command="{Binding ContinueModArchiveInstallCommand}"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Margin="0,0,6,0"/>
                            <Button Content="{x:Static res:Strings.Common_Cancel}"
                                    Command="{Binding CancelModArchiveInstallCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="2"
                        Margin="0,8,0,0"
                        Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DismissModArchiveInstallCompletedCommand}"/>
                    </Border.InputBindings>
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource ModArchiveProgressPanelStyle}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsModArchiveInstallCompleted}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Image Grid.Column="0"
                               Source="{DynamicResource RadiationOnImage}"
                               Width="22"
                               Height="22"
                               Margin="0,1,9,0"
                               VerticalAlignment="Top"/>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{x:Static res:Strings.Mod_InstalledHeading}"
                                       Foreground="{DynamicResource AccentBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding InstalledModArchiveName}"
                                       Foreground="{DynamicResource TextBrush}"
                                       FontWeight="SemiBold"
                                       Margin="0,2,0,0"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding InstalledModArchivePath}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,1,0,0"
                                       TextWrapping="NoWrap"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding InstalledModArchiveDetails}"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
