<UserControl x:Class="StalkerModLauncher.Views.Controls.PdaProfileSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:StalkerModLauncher.Resources"
             xmlns:themes="clr-namespace:StalkerModLauncher.Themes"
             Background="{DynamicResource PdaPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{x:Static themes:PdaThemeSelector.CurrentSource}"/>
                <ResourceDictionary Source="/CORDON;component/Themes/ProfileSettingsStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <CornerRadius x:Key="ProfileSettingPanelCornerRadius">0</CornerRadius>

            <Style x:Key="ProfilePdaSettingPanelStyle" TargetType="Border" BasedOn="{StaticResource ProfileSettingPanelStyle}">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            </Style>

            <Style TargetType="Button" BasedOn="{StaticResource PdaBaseButtonStyle}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="MinWidth" Value="96"/>
                <Setter Property="Padding" Value="12,6"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>

            <Style x:Key="ProfilePrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                <Setter Property="MinHeight" Value="36"/>
                <Setter Property="MinWidth" Value="170"/>
                <Setter Property="Padding" Value="16,6"/>
                <Setter Property="FontSize" Value="12"/>
            </Style>

            <Style x:Key="PdaProfileTextBoxStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Padding" Value="8,5"/>
                <Setter Property="MinHeight" Value="36"/>
            </Style>

            <Style x:Key="PdaProfileFieldBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="3"/>
                <Setter Property="Padding" Value="4,4"/>
            </Style>

            <Style x:Key="PdaProfileEmbeddedTextBoxStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0,2,0,0"/>
            </Style>

            <Style x:Key="PdaProfilePlaceholderTextBoxStyle"
                   TargetType="TextBox"
                   BasedOn="{StaticResource PdaProfileTextBoxStyle}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderBrush" Value="Transparent"/>
                <Setter Property="Foreground" Value="#727B6D"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="IsHitTestVisible" Value="False"/>
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding LaunchArguments}" Value="">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding LaunchArguments}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Visible"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="PdaProfileRadioButtonStyle" TargetType="RadioButton">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <BulletDecorator Background="Transparent">
                                <BulletDecorator.Bullet>
                                    <Grid Width="15" Height="15">
                                        <Ellipse x:Name="Outer" Fill="{DynamicResource PdaRadioBackgroundBrush}" Stroke="{DynamicResource PdaRadioBorderBrush}" StrokeThickness="1"/>
                                        <Ellipse x:Name="Inner" Width="7" Height="7"
                                                 Fill="{StaticResource AccentBrush}" Visibility="Collapsed"/>
                                    </Grid>
                                </BulletDecorator.Bullet>
                                <ContentPresenter Margin="4,0,0,0"
                                                  VerticalAlignment="Center"/>
                            </BulletDecorator>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Inner" Property="Visibility" Value="Visible"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Outer" Property="Stroke" Value="{DynamicResource PdaRadioHoverBorderBrush}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.38"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>


            <Style x:Key="PdaAvxCheckBoxStyle" TargetType="CheckBox">
                <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image x:Name="StateImage"
                                       Source="{StaticResource RadiationOffImage}"
                                       Width="20" Height="20"
                                       Stretch="Uniform"
                                       Margin="0,0,6,0"/>
                                <ContentPresenter RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"/>
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="StateImage" Property="Source" Value="{StaticResource RadiationOnImage}"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="#FFFFFF"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="StateImage" Property="Opacity" Value="0.35"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource PdaPageBackgroundBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                Padding="12">
            <TabControl x:Name="SettingsTabs" TabStripPlacement="Left">
                <TabItem Header="{x:Static res:Strings.Common_Profile}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border x:Name="NameSetting" Style="{StaticResource ProfilePdaSettingPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:Strings.Creation_ProfileName}" Foreground="#929B88" FontSize="11"/>

                                    <Border Style="{StaticResource PdaProfileFieldBorderStyle}"
                                            Height="36" Margin="0,4,0,0">
                                        <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PdaProfileEmbeddedTextBoxStyle}"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border x:Name="DescriptionSetting" Style="{StaticResource ProfilePdaSettingPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:Strings.Common_Description}" Foreground="#929B88" FontSize="11"/>

                                    <Border Style="{StaticResource PdaProfileFieldBorderStyle}"
                                            Height="60" Margin="0,4,0,0">
                                        <TextBox Text="{Binding ProfileDescription, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PdaProfileEmbeddedTextBoxStyle}"
                                                 TextWrapping="Wrap"
                                                 AcceptsReturn="True"/>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border x:Name="StandaloneSetting" Style="{StaticResource ProfilePdaSettingPanelStyle}">
                                <CheckBox IsChecked="{Binding IsStandalone}"
                                          Style="{StaticResource ProfileStandaloneCheckBoxStyle}">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{x:Static res:Strings.Profile_Standalone}"/>
                                        <Run Text="{x:Static res:Strings.SettingsProfile_StandaloneHint}"
                                             Foreground="{DynamicResource MutedTextBrush}" FontSize="11"/>
                                    </TextBlock>
                                </CheckBox>
                            </Border>

                            <Border x:Name="DiscordSetting" Style="{StaticResource ProfilePdaSettingPanelStyle}">
                                <ToggleButton HorizontalAlignment="Left" MinHeight="36" Padding="12,6" FontSize="12" Content="{x:Static res:Strings.SettingsProfile_Discord}"
                                    IsChecked="{Binding IsDiscordStatusEnabled}"
                                    Style="{DynamicResource ProfileToggleButtonStyle}"
                                    ToolTip="{x:Static res:Strings.SettingsProfile_DiscordTooltip}"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.SettingsProfile_LaunchTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border x:Name="LaunchModeSetting" Style="{StaticResource ProfilePdaSettingPanelStyle}">
                                <StackPanel x:Name="LaunchModePanel" Style="{StaticResource ProfileNonStandaloneSectionStyle}">
                                    <TextBlock Text="{x:Static res:Strings.SettingsProfile_LaunchMode}" Foreground="#929B88" FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding UsvfsAvailabilityText}"
                                               Foreground="#727B6D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,9"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ExecutableSetting" Style="{StaticResource ProfilePdaSettingPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:Strings.SettingsProfile_Executable}" Foreground="#929B88" FontSize="11"/>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ExecutableRelativePath, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PdaProfileTextBoxStyle}"/>
                                        <Button Grid.Column="1" Content="{x:Static res:Strings.Common_Browse}" Command="{Binding BrowseExecutableCommand}"
                                                Margin="7,0,0,0" Width="96"/>
                                    </Grid>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Static res:Strings.SettingsProfile_ExePathHint}"
                                                       Foreground="#727B6D"
                                                       FontSize="11"/>
                                            <TextBlock Text="{Binding ExecutableSourceDisplay}"
                                                       TextWrapping="Wrap"
                                                       ToolTip="{Binding ExecutableSourceDisplay}"
                                                       Foreground="#929B88"
                                                       FontSize="11"
                                                       Margin="0,2,0,0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0"
                                                Content="{x:Static res:Strings.SettingsProfile_AutoSelect}"
                                                Command="{Binding ClearExecutableSourceCommand}"
                                                ToolTip="{x:Static res:Strings.SettingsProfile_AutoSelectExeTooltip}"
                                                ToolTipService.ShowOnDisabled="True"
                                                Margin="8,0,0,0"
                                                Padding="12,6"
                                                MinHeight="36"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ArgumentsSetting" Style="{StaticResource ProfilePdaSettingPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:Strings.Creation_LaunchArguments}" Foreground="#929B88" FontSize="11"/>

                                    <Grid>
                                        <TextBox Text="{Binding LaunchArguments, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PdaProfileTextBoxStyle}"
                                                 Height="36"
                                                 VerticalContentAlignment="Center"/>
                                        <TextBox Text="{x:Static res:Strings.SettingsProfile_ArgumentsExample}"
                                                 Style="{StaticResource PdaProfilePlaceholderTextBoxStyle}"
                                                 Height="36"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border x:Name="RendererSetting" Style="{StaticResource ProfilePdaSettingPanelStyle}" Visibility="{Binding IsAnomalyUsvfsOptionsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel
                                           >
                                    <TextBlock Text="{x:Static res:Strings.SettingsProfile_AnomalyEngine}" Foreground="#929B88" FontSize="12" Margin="0,0,0,4"/>
                                    <WrapPanel>
                                        <RadioButton Content="{x:Static res:Strings.SettingsProfile_Launcher}" Style="{StaticResource PdaProfileRadioButtonStyle}"
                                                     IsChecked="{Binding UseAutomaticAnomalyRenderer}" Margin="0,0,10,0"/>
                                        <RadioButton Content="DX8" Style="{StaticResource PdaProfileRadioButtonStyle}"
                                                     IsChecked="{Binding UseAnomalyDx8}" Margin="0,0,10,0"/>
                                        <RadioButton Content="DX9" Style="{StaticResource PdaProfileRadioButtonStyle}"
                                                     IsChecked="{Binding UseAnomalyDx9}" Margin="0,0,10,0"/>
                                        <RadioButton Content="DX10" Style="{StaticResource PdaProfileRadioButtonStyle}"
                                                     IsChecked="{Binding UseAnomalyDx10}" Margin="0,0,10,0"/>
                                        <RadioButton Content="DX11" Style="{StaticResource PdaProfileRadioButtonStyle}"
                                                     IsChecked="{Binding UseAnomalyDx11}" Margin="0,0,14,0"/>
                                        <CheckBox Content="AVX"
                                                  Style="{StaticResource PdaAvxCheckBoxStyle}"
                                                  IsChecked="{Binding AnomalyUseAvx}"
                                                  IsEnabled="{Binding HasManualAnomalyRenderer}"/>
                                    </WrapPanel>
                                    <TextBlock Text="{x:Static res:Strings.SettingsProfile_LauncherHint}"
                                               Foreground="#727B6D"
                                               FontSize="11"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="FsgameSetting" Style="{StaticResource ProfilePdaSettingPanelStyle}">
                                <StackPanel x:Name="FsgamePanel">
                                    <TextBlock Text="{x:Static res:Strings.SettingsProfile_FsgameSource}" Foreground="#929B88"
                                               FontSize="11" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding FsgameSourceDisplay}" Foreground="#929B88"
                                               FontSize="11" TextWrapping="Wrap"/>
                                    <WrapPanel Margin="0,6,0,0" IsEnabled="{Binding CanChooseFsgame}">
                                        <Button Content="{x:Static res:Strings.SettingsProfile_SelectFile}" Command="{Binding BrowseFsgameCommand}"
                                                Margin="0,0,8,0"/>
                                        <Button Content="{x:Static res:Strings.SettingsProfile_AutoSelect}" Command="{Binding ClearFsgameSourceCommand}"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.SettingsProfile_DataModsTab}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,0,8,0">
                            <Border x:Name="UserDataSetting" Style="{StaticResource ProfilePdaSettingPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:Strings.SettingsProfile_StandaloneData}"
                                        Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                        TextWrapping="Wrap" Visibility="{Binding IsStandalone, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                    <StackPanel x:Name="UserDataPanel" Style="{StaticResource ProfileNonStandaloneSectionStyle}">
                                        <TextBlock Text="{x:Static res:Strings.SettingsProfile_UserData}" Foreground="#929B88" FontSize="11" Margin="0,0,0,5"/>
                                        <StackPanel IsEnabled="{Binding CanChooseGameData}">
                                            <RadioButton Content="{x:Static res:Strings.SettingsProfile_UserDataProfile}" Style="{StaticResource PdaProfileRadioButtonStyle}"
                                                         IsChecked="{Binding UseProfileGameData}" Margin="0,0,0,5"/>
                                            <RadioButton Content="{x:Static res:Strings.SettingsProfile_UserDataGame}" Style="{StaticResource PdaProfileRadioButtonStyle}"
                                                         IsChecked="{Binding UseBaseGameData}"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding GameDataDescription}" Foreground="#929B88" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,5,0,0"/>
                                        <Button Content="{x:Static res:Strings.SettingsProfile_CopyMissingData}"
                                                Command="{Binding CopyGameDataCommand}" IsEnabled="{Binding CanChooseGameData}"
                                                HorizontalAlignment="Left" Margin="0,6,0,0"/>

                                        <TextBlock Text="{x:Static res:Strings.SettingsProfile_CopyImmediateHint}"
                                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                                   TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ModFolderSetting" Style="{StaticResource ProfilePdaSettingPanelStyle}">
                                <StackPanel>
                                    <TextBlock Text="{x:Static res:Strings.SettingsProfile_InstalledModsFolder}" Foreground="#929B88" FontSize="11"/>

                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding ModInstallPath, UpdateSourceTrigger=PropertyChanged}"
                                                 Style="{StaticResource PdaProfileTextBoxStyle}"
                                                 ToolTip="{x:Static res:Strings.SettingsProfile_ModFolderTooltip}"/>
                                        <Button Grid.Column="1" Content="{x:Static res:Strings.Common_Browse}" Command="{Binding BrowseModInstallPathCommand}"
                                                Margin="7,0,0,0" Width="96"/>
                                        <Button Grid.Column="2" Content="{x:Static res:Strings.Common_Default}" Command="{Binding ResetModInstallPathCommand}"
                                                Margin="7,0,0,0" Width="110"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="Mo2Panel">
                                <TextBlock Text="{x:Static res:Strings.SettingsProfile_Mo2Heading}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,10"/>

                                <Border x:Name="OverwriteSetting" Style="{StaticResource ProfilePdaSettingPanelStyle}" Visibility="{Binding HasMo2Overwrite, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{x:Static res:Strings.SettingsProfile_Mo2Overwrite}" FontWeight="SemiBold" FontSize="11"/>
                                            <TextBlock Text="{Binding Mo2OverwritePath}" Foreground="#727B6D" FontSize="9"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Mo2OverwritePath}"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="{x:Static res:Strings.Common_Disable}" Command="{Binding RemoveMo2OverwriteCommand}"
                                                Margin="7,0,0,0" Padding="12,6" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border x:Name="ModOrderSetting" Style="{StaticResource ProfilePdaSettingPanelStyle}">
                                    <StackPanel>
                                        <Button Content="{x:Static res:Strings.SettingsProfile_Mo2Apply}"
                                            Command="{Binding ImportMo2ModListCommand}"
                                            ToolTip="{x:Static res:Strings.SettingsProfile_Mo2ApplyTooltip}"
                                            HorizontalAlignment="Left"/>

                                        <TextBlock Text="{x:Static res:Strings.SettingsProfile_Mo2ImmediateHint}"
                                            Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                            TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Border>

        <WrapPanel Grid.Row="1" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static res:Strings.SettingsProfile_Apply}"
                    Command="{Binding SaveCommand}" MinWidth="110" Margin="0,0,8,0"/>
            <Button Content="{x:Static res:Strings.SettingsProfile_SaveClose}"
                    Click="SaveButton_OnClick" Style="{StaticResource ProfilePrimaryButtonStyle}"/>
        </WrapPanel>
    </Grid>
</UserControl>
