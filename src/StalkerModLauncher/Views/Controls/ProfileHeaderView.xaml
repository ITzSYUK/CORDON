<UserControl x:Class="StalkerModLauncher.Views.Controls.ProfileHeaderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infrastructure="clr-namespace:StalkerModLauncher.Infrastructure"
             xmlns:res="clr-namespace:StalkerModLauncher.Resources"
             Focusable="False" Loaded="ProfileActions_OnChanged">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,8,0" ClipToBounds="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="12"
                    Height="12"
                    CornerRadius="6"
                    VerticalAlignment="Top"
                    Margin="0,8,10,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGameValid}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
            </Border>
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock
                               Text="{Binding SelectedProfile.Name, FallbackValue={x:Static res:Strings.Common_Profile}}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               LineHeight="28"
                               MaxHeight="56"/>
                        <TextBlock Grid.Row="1"
                                   Text="{Binding ValidationSummary}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   Margin="0,1,0,0"
                                   TextWrapping="Wrap"
                                   LineHeight="18"
                                   MaxHeight="54"/>
                    </Grid>
            </Grid>

        <Grid Grid.Column="1"
              HorizontalAlignment="Right"
              VerticalAlignment="Top"
              Panel.ZIndex="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="ProfileActionsViewport" Grid.Column="0"
                    Height="40"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ClipToBounds="True"
                    Margin="0,0,4,8"
                    Width="0"
                    Opacity="0"
                    IsHitTestVisible="False">
                <StackPanel x:Name="ProfileActions" Height="38"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <Button Content="{x:Static res:Strings.Common_Status}"
                            Click="ProfileHealthButton_OnClick"
                            Margin="0,0,8,0"/>
                    <Button Content="{x:Static res:Strings.Common_Settings}"
                            Click="EditProfileButton_OnClick"
                            Margin="0,0,8,0"/>
                    <Button Content="{x:Static res:Strings.Common_ProfileFolder}"
                            Command="{Binding OpenProfileFolderCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="{x:Static res:Strings.Screenshots_Title}"
                            Click="ScreenshotsButton_OnClick"
                            Margin="0,0,8,0"/>
                    <Button Content="{x:Static res:Strings.Saves_Title}"
                            Click="SavesButton_OnClick"
                            Margin="0,0,12,0"/>
                </StackPanel>
            </Border>

            <ToggleButton x:Name="ProfileActionsToggle"
                          Grid.Column="1"
                          IsChecked="True"
                          Checked="ProfileActions_OnChanged"
                          Unchecked="ProfileActions_OnChanged"
                          infrastructure:UiSound.Kind="ProfileActionsToggle"
                          Style="{DynamicResource ProfileActionsToggleButtonStyle}"
                          VerticalAlignment="Center"
                          ToolTip="{x:Static res:Strings.Profile_ActionsTooltip}"
                          Margin="0,0,6,8"/>

            <Button Grid.Column="2"
                    Content="{x:Static res:Strings.Common_Launch}"
                    Command="{Binding LaunchCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    FontSize="15"
                    Margin="0,0,0,8"
                    MinWidth="112"/>
        </Grid>
    </Grid>
</UserControl>
