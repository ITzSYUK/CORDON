<UserControl x:Class="StalkerModLauncher.Views.Controls.PdaLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:themes="clr-namespace:StalkerModLauncher.Themes"
             Background="{DynamicResource PdaPageBackgroundBrush}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="{x:Static themes:PdaThemeSelector.CurrentSource}"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Margin="10">
        <TextBox
                 Text="{Binding ActivityLog.Text, Mode=OneWay}"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Background="{DynamicResource PdaLogBackgroundBrush}"
                 BorderBrush="{DynamicResource StrokeBrush}"
                 Foreground="{DynamicResource PdaLogTextBrush}"
                 FontFamily="Consolas"
                 FontSize="11"/>
    </Grid>
</UserControl>
