<UserControl x:Class="StalkerModLauncher.Views.Controls.Mo2ImportContentView" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:res="clr-namespace:StalkerModLauncher.Resources" FontSize="12" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CORDON;component/Themes/Palette.xaml" />
                <ResourceDictionary Source="/CORDON;component/Themes/SharedStyles.xaml" />
                <ResourceDictionary Source="/CORDON;component/Themes/Mo2ImportStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Top">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSourceStep}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{x:Static res:Strings.Mo2_Source}" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,10" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SourcePathTextBox" Text="{Binding SourceDisplay, Mode=OneWay}" IsReadOnly="True" ToolTip="{Binding SourcePath}" Style="{DynamicResource Mo2SourceTextBoxStyle}" />
                    <Button Grid.Column="1" Content="{x:Static res:Strings.Mo2_SourceFolder}" Command="{Binding BrowseSourceFolderCommand}" Margin="{DynamicResource Mo2SourceButtonMargin}" />
                    <TextBlock Grid.Column="2" Text="{x:Static res:Strings.Mo2_Or}" VerticalAlignment="Center" Margin="{DynamicResource Mo2SourceButtonMargin}" />
                    <Button Grid.Column="3" Content="{x:Static res:Strings.Mo2_ModListFile}" Command="{Binding BrowseModListCommand}" Margin="{DynamicResource Mo2SourceButtonMargin}" />
                </Grid>
                <TextBlock FontSize="17" FontWeight="SemiBold" Margin="0,14,0,10" Text="{x:Static res:Strings.Mo2_Profile}" />
                <Grid>
                    <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedMo2Profile}" DisplayMemberPath="Name" Style="{StaticResource Mo2ComboBoxStyle}" Height="{Binding ActualHeight, ElementName=SourcePathTextBox}" ToolTip="{Binding SelectedMo2Profile.Name}" />
                    <TextBlock Text="{x:Static res:Strings.Mo2_SelectProfilePlaceholder}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Mo2PlaceholderTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SelectedMo2Profile}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <TextBlock Text="{x:Static res:Strings.Mo2_DetectedPaths}" FontSize="15" FontWeight="SemiBold" Margin="{DynamicResource Mo2DetectedPathsMargin}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="115" x:Name="SourceLabelColumn" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:Strings.Common_BaseGame}" />
                        <TextBlock Text="*" Foreground="{DynamicResource DangerBrush}" Margin="{DynamicResource Mo2RequiredMarkerMargin}" FontWeight="Bold" />
                    </StackPanel>
                    <TextBox Grid.Column="1" Text="{Binding GamePath}" IsReadOnly="True" ToolTip="{Binding GamePath}" Margin="{DynamicResource Mo2SourceFieldMargin}" />
                    <Button Grid.Column="2" Content="{x:Static res:Strings.Common_Change}" Command="{Binding BrowseGameCommand}" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{x:Static res:Strings.Mo2_PathNotFound}" Foreground="{DynamicResource DangerBrush}" Margin="{DynamicResource Mo2PathWarningMargin}" FontSize="{DynamicResource Mo2PathWarningFontSize}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGamePathValid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="{DynamicResource Mo2LaunchModeMargin}">
                        <TextBlock Text="{x:Static res:Strings.Mo2_ModsFolder}" />
                        <TextBlock Text="*" Foreground="{DynamicResource DangerBrush}" Margin="{DynamicResource Mo2RequiredMarkerMargin}" FontWeight="Bold" />
                    </StackPanel>
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding ModsPath}" IsReadOnly="True" ToolTip="{Binding ModsPath}" Margin="{DynamicResource Mo2SourceFieldMargin}" />
                    <Button Grid.Row="2" Grid.Column="2" Content="{x:Static res:Strings.Common_Change}" Command="{Binding BrowseModsCommand}" Margin="0,0,0,2" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{x:Static res:Strings.Mo2_PathNotFound}" Foreground="{DynamicResource DangerBrush}" Margin="{DynamicResource Mo2PathWarningMargin}" FontSize="{DynamicResource Mo2PathWarningFontSize}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsModsPathValid}" Value="False">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Row="4" Text="{x:Static res:Strings.Mo2_OverwriteFolder}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding OverwritePath}" IsReadOnly="True" ToolTip="{Binding OverwritePath}" Margin="{DynamicResource Mo2OverwriteFieldMargin}" />
                    <Button Grid.Row="4" Grid.Column="2" Content="{x:Static res:Strings.Common_Change}" Command="{Binding BrowseOverwriteCommand}" />
                </Grid>
                <TextBlock Text="{x:Static res:Strings.Mo2_ReadOnlyHint}" Foreground="{DynamicResource MutedTextBrush}" Margin="{DynamicResource Mo2ReadOnlyHintMargin}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Static res:Strings.Mo2_RequiredFieldsHint}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <Grid TextElement.FontSize="{DynamicResource Mo2PreviewFontSize}">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsPreviewStep}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" x:Name="ProfileLabelColumn" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Static res:Strings.Mo2_NewProfile}" VerticalAlignment="Center" />
                <TextBox x:Name="ProfileNameTextBox" Grid.Column="1" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
            <StackPanel Grid.Row="1" Margin="{DynamicResource Mo2SummaryPanelMargin}" HorizontalAlignment="Stretch">
                <TextBlock Text="{Binding PreviewSummary}" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Stretch" FontSize="{DynamicResource Mo2SummaryFontSize}" />
                <TextBlock Text="{Binding Preview.ExecutableSummary}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="{DynamicResource Mo2SummaryDetailMargin}" HorizontalAlignment="Stretch" ToolTip="{Binding Preview.ExecutableSummary}" FontSize="{DynamicResource Mo2SummaryFontSize}" />
                <TextBlock Text="{Binding Preview.OverwriteSummary}" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="{DynamicResource Mo2SummaryDetailMargin}" HorizontalAlignment="Stretch" ToolTip="{Binding Preview.OverwriteSummary}" FontSize="{DynamicResource Mo2SummaryFontSize}" />
            </StackPanel>
            <Grid Grid.Row="2" Margin="{DynamicResource Mo2FiltersMargin}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                    <!-- Hint aligned to the TextBox text origin (19,11): 1px border plus doubled 8,5 padding, verified by render test. -->
                    <TextBlock Text="{x:Static res:Strings.Mo2_SearchPlaceholder}" Margin="19,11,0,0" VerticalAlignment="Top">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Mo2PlaceholderTextStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding SearchText}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <CheckBox Grid.Row="1" Content="{x:Static res:Strings.Mo2_ShowOnlyProblems}" IsChecked="{Binding ShowOnlyProblems}" Margin="{DynamicResource Mo2ProblemFilterMargin}" VerticalAlignment="Center" FontSize="10" Style="{DynamicResource Mo2ContentCheckBoxStyle}" />
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="{DynamicResource Mo2LaunchModeMargin}" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:Strings.SettingsProfile_LaunchMode}" Foreground="{DynamicResource MutedTextBrush}" Margin="{DynamicResource Mo2LaunchModeLabelMargin}" VerticalAlignment="Center" ToolTip="{x:Static res:Strings.Mo2_LaunchModeHint}" FontSize="{DynamicResource Mo2LaunchModeFontSize}" />
                    <RadioButton Content="Workspace" IsChecked="{Binding UseLinkedWorkspace}" Margin="{DynamicResource Mo2WorkspaceOptionMargin}" VerticalAlignment="Center" Style="{StaticResource Mo2LaunchRadioButtonStyle}" FontSize="{DynamicResource Mo2LaunchModeFontSize}" />
                    <RadioButton Content="USVFS" IsChecked="{Binding UseVirtualFileSystem}" VerticalAlignment="Center" Style="{StaticResource Mo2LaunchRadioButtonStyle}" FontSize="{DynamicResource Mo2LaunchModeFontSize}" />
                    <TextBlock Text="?" Foreground="{DynamicResource MutedTextBrush}" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{x:Static res:Strings.Mo2_LaunchModeHint}" FontWeight="Bold" FontSize="{DynamicResource Mo2LaunchHelpFontSize}" />
                </StackPanel>
            </Grid>
            <DataGrid Grid.Row="3" ItemsSource="{Binding VisibleEntries}" AutoGenerateColumns="False" Style="{StaticResource Mo2DataGridStyle}" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Order}" Width="38" x:Name="OrderColumn" />
                    <DataGridCheckBoxColumn Header="{x:Static res:Strings.Mo2_Enabled}" Binding="{Binding IsEnabled, Mode=OneWay}" Width="60" x:Name="EnabledColumn" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Common_Mod}" Binding="{Binding Name}" Width="2*" />
                    <DataGridTextColumn Header="{x:Static res:Strings.Mo2_Group}" Binding="{Binding GroupName}" Width="*" />
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Common_Status}" Width="160" SortMemberPath="Status" x:Name="StatusColumn">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" ToolTip="{Binding Status}">
                                    <TextBlock Text="●" Margin="{DynamicResource Mo2StatusMarkerMargin}" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentGreenBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAmbiguous}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Status}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="{x:Static res:Strings.Common_Folder}" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding SourcePath}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding PathDisplay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding SourcePath}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMultipleCandidates}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Grid Grid.ColumnSpan="2">
                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasMultipleCandidates}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding CandidateOptions}" SelectedValuePath="Path" SelectedValue="{Binding SourcePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="{x:Static res:Strings.Mo2_SelectMatchingFolder}">
                                            <ComboBox.Style>
                                                <Style TargetType="ComboBox" BasedOn="{StaticResource Mo2ComboBoxStyle}">
                                                    <Setter Property="MinHeight" Value="{DynamicResource Mo2CandidateMinHeight}" />
                                                    <Setter Property="Padding" Value="{DynamicResource Mo2CandidatePadding}" />
                                                </Style>
                                            </ComboBox.Style>
                                        </ComboBox>
                                        <TextBlock Text="{x:Static res:Strings.Mo2_SelectFolderPlaceholder}" IsHitTestVisible="False" VerticalAlignment="Center" Margin="{DynamicResource Mo2CandidatePlaceholderMargin}" Foreground="{DynamicResource MutedTextBrush}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                    <Button Grid.Column="1" Content="{x:Static res:Strings.Mo2Service_SelectFolder}" Command="{Binding DataContext.BrowseMissingModFolderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="{DynamicResource Mo2FolderBrowseButtonMargin}" Padding="{DynamicResource Mo2FolderBrowseButtonPadding}" Style="{DynamicResource Mo2FolderBrowseButtonStyle}" />
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <CheckBox Grid.Row="4" Content="{x:Static res:Strings.Mo2_EnableOverwrite}" IsChecked="{Binding IncludeOverwrite}" Margin="{DynamicResource Mo2OverwriteOptionMargin}" FontSize="10" IsEnabled="{Binding Preview.HasOverwriteContent}" Style="{DynamicResource Mo2ContentCheckBoxStyle}" />
        </Grid>
    </Grid>
</UserControl>
