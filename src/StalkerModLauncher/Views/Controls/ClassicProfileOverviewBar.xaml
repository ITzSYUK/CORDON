<UserControl x:Class="StalkerModLauncher.Views.Controls.ClassicProfileOverviewBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:StalkerModLauncher.Resources"
             Background="Transparent">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/CORDON;component/Themes/Palette.xaml"/>
                <ResourceDictionary Source="/CORDON;component/Themes/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        <Style x:Key="OverviewLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="OverviewValueStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,4,0,0"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.08*"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                MinHeight="58"
                Background="{DynamicResource FieldBackgroundBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="9"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="40"/>
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,8,0">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProfile.IsStandalone}" Value="True">
                                    <Setter Property="Opacity" Value="0.35"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="{x:Static res:Strings.Common_BaseGame}" Style="{StaticResource OverviewLabelStyle}"/>
                    <TextBox Grid.Row="1"
                             Text="{Binding SelectedProfile.GameInstallPath, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Padding="0,2,0,0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"/>
                </Grid>

                <Button Grid.Column="1"
                        Command="{Binding ChooseGameFolderCommand}"
                        ToolTip="{x:Static res:Strings.Common_ChooseBaseGame}"
                        ToolTipService.InitialShowDelay="600"
                        ToolTipService.BetweenShowDelay="0"
                        Width="34"
                        Height="34"
                        MinHeight="34"
                        Padding="5"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ModToolbarIconButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedProfile.IsStandalone}" Value="True">
                                    <Setter Property="Opacity" Value="0.35"/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Viewbox Width="23" Height="23">
                        <Canvas Width="24" Height="24">
                            <Path Data="M4,18 V6.5 C4,5.672 4.672,5 5.5,5 H10 L12,7 H18.5 C19.328,7 20,7.672 20,8.5 V18 C20,18.828 19.328,19.5 18.5,19.5 H5.5 C4.672,19.5 4,18.828 4,18 Z"
                                  Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path Data="M8.5,13 L11,15.5 L16,10.5"
                                  Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <Border Grid.Column="2" Width="1" Height="44" Margin="4,0"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Background="{DynamicResource StrokeBrush}"/>

                <Button Grid.Column="3"
                        Command="{Binding ScanForModsCommand}"
                        Style="{StaticResource ModToolbarIconButtonStyle}"
                        ToolTip="{x:Static res:Strings.Mod_ScanFolderTooltip}"
                        ToolTipService.InitialShowDelay="600"
                        ToolTipService.BetweenShowDelay="0"
                        Width="34"
                        Height="34"
                        MinHeight="34"
                        Padding="5"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="23" Height="23">
                        <Canvas Width="24" Height="24">
                            <Path Data="M4,5.5 C4,4.672 4.672,4 5.5,4 H10 L12,6 H18.5 C19.328,6 20,6.672 20,7.5 V10 M11.4,19.5 H5.5 C4.672,19.5 4,18.828 4,18 V8"
                                  Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Ellipse Canvas.Left="12" Canvas.Top="11" Width="7" Height="7"
                                     Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7"/>
                            <Path Data="M17.5,16.5 L21,20" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>

                <Button Grid.Column="4"
                        Command="{Binding InstallModArchiveCommand}"
                        Style="{StaticResource ModToolbarIconButtonStyle}"
                        ToolTip="{x:Static res:Strings.Mod_InstallArchiveTooltip}"
                        ToolTipService.InitialShowDelay="600"
                        ToolTipService.BetweenShowDelay="0"
                        Width="34"
                        Height="34"
                        MinHeight="34"
                        Padding="5"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid Width="23" Height="23">
                        <Path Data="M5,3.5 H14 L19,8.5 V20.5 H5 Z M14,3.5 V8.5 H19"
                              Stroke="{DynamicResource TextBrush}"
                              StrokeThickness="1.6"
                              StrokeLineJoin="Round"/>
                        <TextBlock Text="ZIP"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontSize="6"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </Grid>
                </Button>

                <Button Grid.Column="5"
                        Command="{Binding AddModCommand}"
                        Style="{StaticResource ModToolbarIconButtonStyle}"
                        ToolTip="{x:Static res:Strings.Mod_AddFolderTooltip}"
                        ToolTipService.InitialShowDelay="600"
                        ToolTipService.BetweenShowDelay="0"
                        Width="34"
                        Height="34"
                        MinHeight="34"
                        Padding="5"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Viewbox Width="23" Height="23">
                        <Canvas Width="24" Height="24">
                            <Path Data="M4,18 V6.5 C4,5.672 4.672,5 5.5,5 H10 L12,7 H18.5 C19.328,7 20,7.672 20,8.5 V18 C20,18.828 19.328,19.5 18.5,19.5 H5.5 C4.672,19.5 4,18.828 4,18 Z"
                                  Stroke="{DynamicResource TextBrush}" StrokeThickness="1.7"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Path Data="M12,10 V16 M9,13 H15" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.8"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                MinHeight="58"
                Background="{DynamicResource FieldBackgroundBrush}"
                BorderBrush="{DynamicResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="0.75*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="{x:Static res:Strings.Common_Binary}" Style="{StaticResource OverviewLabelStyle}"/>
                    <TextBlock Text="{Binding SelectedProfile.ExecutableRelativePath}"
                               ToolTip="{Binding SelectedProfile.ExecutableRelativePath}"
                               ToolTipService.InitialShowDelay="600"
                               ToolTipService.BetweenShowDelay="0"
                               Style="{StaticResource OverviewValueStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{x:Static res:Strings.Common_Arguments}" Style="{StaticResource OverviewLabelStyle}"/>
                    <TextBlock Text="{Binding SelectedProfile.LaunchArguments}"
                               ToolTip="{Binding SelectedProfile.LaunchArguments}"
                               ToolTipService.InitialShowDelay="600"
                               ToolTipService.BetweenShowDelay="0"
                               Style="{StaticResource OverviewValueStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="0,0,12,0">
                    <TextBlock Text="{x:Static res:Strings.Common_ModCount}" Style="{StaticResource OverviewLabelStyle}"/>
                    <TextBlock Text="{Binding SelectedProfile.Mods.Count}" Style="{StaticResource OverviewValueStyle}"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="{x:Static res:Strings.Common_PlayTime}" Style="{StaticResource OverviewLabelStyle}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="{Binding SelectedProfile.PlaytimeDisplay}" FontSize="13"/>
                        <TextBlock Text="{Binding SelectedProfile.LastPlayedDisplay}" Margin="10,1,0,0"
                                   Foreground="{DynamicResource MutedTextBrush}" FontSize="11"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
