<Window x:Class="StalkerModLauncher.Views.ProfileSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки профиля"
        Width="820"
        Height="680"
        MinWidth="620"
        MinHeight="460"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        SourceInitialized="Window_OnSourceInitialized"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="ProfileFieldBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FieldBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8,4"/>
        </Style>

        <Style x:Key="ProfileSectionDividerStyle" TargetType="Border">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Background" Value="{StaticResource StrokeBrush}"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
        </Style>

        <Style x:Key="ProfileEmbeddedTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0,2,0,0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="ProfilePlaceholderTextBoxStyle"
               TargetType="TextBox"
               BasedOn="{StaticResource ProfileEmbeddedTextBoxStyle}">
            <Setter Property="Foreground" Value="{StaticResource DisabledTextBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding LaunchArguments}" Value="">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding LaunchArguments}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ProfileLaunchRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <BulletDecorator Background="Transparent">
                            <BulletDecorator.Bullet>
                                <Grid Width="15" Height="15">
                                    <Ellipse x:Name="OuterCircle"
                                             Fill="{StaticResource FieldBackgroundBrush}"
                                             Stroke="{StaticResource MutedTextBrush}"
                                             StrokeThickness="1"/>
                                    <Ellipse x:Name="InnerCircle"
                                             Width="7" Height="7"
                                             Fill="{StaticResource AccentBrush}"
                                             Visibility="Collapsed"/>
                                </Grid>
                            </BulletDecorator.Bullet>
                            <ContentPresenter Margin="4,0,0,0"
                                              VerticalAlignment="Center"/>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="InnerCircle" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterCircle" Property="Stroke" Value="{StaticResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,8,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Название профиля"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"/>
                        <Border Style="{StaticResource ProfileFieldBorderStyle}"
                                Height="34"
                                Margin="0,4,0,0">
                            <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProfileEmbeddedTextBoxStyle}"
                                     Padding="0"/>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="Описание"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"/>
                        <Border Style="{StaticResource ProfileFieldBorderStyle}"
                                Height="60"
                                Margin="0,4,0,0">
                            <TextBox Text="{Binding ProfileDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProfileEmbeddedTextBoxStyle}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"/>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="2"
                            Style="{StaticResource ProfileSectionDividerStyle}"
                            Margin="0,14,0,14"/>

                    <CheckBox Grid.Row="3"
                              IsChecked="{Binding IsStandalone}"
                              Margin="0,0,0,8">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="Автономная сборка"/>
                            <Run Foreground="{StaticResource MutedTextBrush}" FontSize="11"
                                 Text=" - мод имеет свой движок и все файлы игры, запускается из своей папки"/>
                        </TextBlock>
                    </CheckBox>

                    <StackPanel Grid.Row="4" Margin="0,4,0,12">
                        <TextBlock Text="Система запуска"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,6"/>
                        <WrapPanel>
                            <RadioButton Content="Workspace"
                                         Style="{StaticResource ProfileLaunchRadioButtonStyle}"
                                         IsChecked="{Binding UseLinkedWorkspace, Mode=TwoWay}"
                                         Margin="0,0,18,0"/>
                            <RadioButton Content="USVFS"
                                         Style="{StaticResource ProfileLaunchRadioButtonStyle}"
                                         IsChecked="{Binding UseVirtualFileSystem, Mode=TwoWay}"
                                         IsEnabled="{Binding CanUseUsvfs}"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding UsvfsAvailabilityText}"
                                   Foreground="{StaticResource DisabledTextBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>

                        <StackPanel Margin="0,18,0,0"
                                    Visibility="{Binding IsAnomalyUsvfsOptionsVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Движок Anomaly"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,5"/>
                            <WrapPanel>
                                <RadioButton Content="Лаунчер"
                                             Style="{StaticResource ProfileLaunchRadioButtonStyle}"
                                             IsChecked="{Binding UseAutomaticAnomalyRenderer, Mode=TwoWay}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>
                                <RadioButton Content="DX8"
                                             Style="{StaticResource ProfileLaunchRadioButtonStyle}"
                                             IsChecked="{Binding UseAnomalyDx8, Mode=TwoWay}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>
                                <RadioButton Content="DX9"
                                             Style="{StaticResource ProfileLaunchRadioButtonStyle}"
                                             IsChecked="{Binding UseAnomalyDx9, Mode=TwoWay}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>
                                <RadioButton Content="DX10"
                                             Style="{StaticResource ProfileLaunchRadioButtonStyle}"
                                             IsChecked="{Binding UseAnomalyDx10, Mode=TwoWay}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,12,0"/>
                                <RadioButton Content="DX11"
                                             Style="{StaticResource ProfileLaunchRadioButtonStyle}"
                                             IsChecked="{Binding UseAnomalyDx11, Mode=TwoWay}"
                                             VerticalAlignment="Center"
                                             Margin="0,0,16,0"/>
                                <CheckBox Content="AVX"
                                          IsChecked="{Binding AnomalyUseAvx}"
                                          IsEnabled="{Binding HasManualAnomalyRenderer}"
                                          VerticalAlignment="Center"/>
                            </WrapPanel>
                            <TextBlock Text="Лаунчер запускает AnomalyLauncher.exe. Ручной выбор запускает выбранный движок напрямую и сохраняет приоритет модов."
                                       Foreground="{StaticResource DisabledTextBrush}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>

                        <Border Style="{StaticResource ProfileSectionDividerStyle}" Margin="0,14,0,14"/>

                        <StackPanel>
                            <TextBlock Text="Пользовательские данные" Foreground="{StaticResource MutedTextBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <StackPanel IsEnabled="{Binding CanChooseGameData}">
                                <RadioButton Content="В папке профиля" Style="{StaticResource ProfileLaunchRadioButtonStyle}"
                                             IsChecked="{Binding UseProfileGameData}" Margin="0,0,0,5"/>
                                <RadioButton Content="В папке данных базовой игры" Style="{StaticResource ProfileLaunchRadioButtonStyle}"
                                             IsChecked="{Binding UseBaseGameData}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding GameDataDescription}" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0"/>
                            <Button Content="Скопировать недостающие данные в выбранную папку"
                                    Command="{Binding CopyGameDataCommand}" IsEnabled="{Binding CanChooseGameData}"
                                    HorizontalAlignment="Left" Margin="0,6,0,0"/>
                            <TextBlock Text="Источник fsgame.ltx" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="12" Margin="0,12,0,4"/>
                            <TextBlock Text="{Binding FsgameSourceDisplay}" Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11" TextWrapping="Wrap"/>
                            <WrapPanel Margin="0,6,0,0" IsEnabled="{Binding CanChooseFsgame}">
                                <Button Content="Выбрать файл..." Command="{Binding BrowseFsgameCommand}"
                                        Margin="0,0,8,0"/>
                                <Button Content="Выбирать автоматически" Command="{Binding ClearFsgameSourceCommand}"/>
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Row="5"
                            Style="{StaticResource ProfileSectionDividerStyle}"
                            Margin="0,2,0,14"/>

                    <TextBlock Grid.Row="6"
                               Text="Файл запуска (.exe)"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"/>

                    <Border Grid.Row="7"
                            Style="{StaticResource ProfileFieldBorderStyle}"
                            Margin="0,4,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0"
                                     Text="{Binding ExecutableRelativePath, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ProfileEmbeddedTextBoxStyle}"/>
                            <Button Grid.Column="1"
                                    Content="Обзор..."
                                    Command="{Binding BrowseExecutableCommand}"
                                    Margin="8,0,0,0"
                                    Width="92"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="8" Margin="0,2,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Путь до .exe относительно папки игры или мода"
                                       Foreground="{StaticResource DisabledTextBrush}"
                                       FontSize="11"/>
                            <TextBlock Text="{Binding ExecutableSourceDisplay}"
                                       Foreground="{StaticResource MutedTextBrush}"
                                       FontSize="11"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="Выбирать автоматически"
                                Command="{Binding ClearExecutableSourceCommand}"
                                ToolTip="Снять ручной выбор источника EXE. Лаунчер будет брать файл запуска из включенного мода с самым высоким приоритетом."
                                ToolTipService.ShowOnDisabled="True"
                                Margin="8,0,0,0"
                                Padding="10,4"
                                MinHeight="26"
                                VerticalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasManualExecutableSource}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="9" Margin="0,12,0,0">
                        <TextBlock Text="Параметры запуска"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"/>
                        <Border Style="{StaticResource ProfileFieldBorderStyle}"
                                Height="38"
                                Margin="0,4,0,0">
                            <Grid>
                                <TextBox Text="{Binding LaunchArguments, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ProfileEmbeddedTextBoxStyle}"
                                         Padding="0"/>
                                <TextBox Text="Например: -nointro -nosound"
                                         Style="{StaticResource ProfilePlaceholderTextBoxStyle}"
                                         Padding="0"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Row="10" Margin="0,14,0,0">
                        <TextBlock Text="Папка установленных модов"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"/>
                        <Border Style="{StaticResource ProfileFieldBorderStyle}"
                                Margin="0,4,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding ModInstallPath, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ProfileEmbeddedTextBoxStyle}"
                                         ToolTip="Архивы распаковываются сюда. Workspace для хранения исходников не используется."/>
                                <Button Grid.Column="1"
                                        Content="Обзор..."
                                        Command="{Binding BrowseModInstallPathCommand}"
                                        Margin="8,0,0,0"
                                        Width="92"
                                        VerticalAlignment="Center"/>
                                <Button Grid.Column="2"
                                        Content="По умолчанию"
                                        Command="{Binding ResetModInstallPathCommand}"
                                        Margin="8,0,0,0"
                                        Width="110"
                                        VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <Border Grid.Row="11" Background="{StaticResource FieldBackgroundBrush}"
                            BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="10" Margin="0,14,0,0"
                            Visibility="{Binding HasMo2Overwrite, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Дополнительный слой MO2 overwrite" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding Mo2OverwritePath}" Foreground="{StaticResource MutedTextBrush}"
                                           FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Mo2OverwritePath}"/>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Отключить" Command="{Binding RemoveMo2OverwriteCommand}"
                                    Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="12" Margin="0,16,0,0">
                        <TextBlock Text="Порядок модов MO2"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,4"/>
                        <Button Content="Применить порядок модов из профиля MO2..."
                                Command="{Binding ImportMo2ModListCommand}"
                                ToolTip="Выберите файл modlist.txt из профиля MO2. Лаунчер применит порядок и включённое состояние только к уже добавленным модам; новые моды и папки импортированы не будут."
                                HorizontalAlignment="Left"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="1" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ToggleButton Grid.Column="0"
                          Content="Показывать статус профиля в Discord"
                          IsChecked="{Binding IsDiscordStatusEnabled}"
                          Style="{StaticResource ProfileToggleButtonStyle}"
                          ToolTip="Статус отображается только во время запуска этого профиля. Отключите его, если мод уже публикует собственный Discord Rich Presence."
                          Margin="0,0,8,0"/>
            <WrapPanel Grid.Column="2" HorizontalAlignment="Right">
                <Button Content="Сохранить"
                        Command="{Binding SaveCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="Готово"
                        Click="CloseButton_OnClick"
                        Style="{StaticResource PrimaryButtonStyle}"
                        MinWidth="96"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
