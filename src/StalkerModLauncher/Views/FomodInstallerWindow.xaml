<Window x:Class="StalkerModLauncher.Views.FomodInstallerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:StalkerModLauncher.Resources"
        xmlns:controls="clr-namespace:StalkerModLauncher.Views.Controls"
        Title="{x:Static res:Strings.Fomod_Title}"
        Width="980" Height="700" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        ShowInTaskbar="False" ResizeMode="CanResizeWithGrip"
        SourceInitialized="FomodInstallerWindow_OnSourceInitialized">
    <controls:FomodInstallerContentView Margin="20"/>
</Window>
