<Window x:Class="StalkerModLauncher.Views.ProfileHealthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infrastructure="clr-namespace:StalkerModLauncher.Infrastructure"
        xmlns:res="clr-namespace:StalkerModLauncher.Resources"
        Title="{x:Static res:Strings.Health_Title}"
        Width="900"
        Height="650"
        MinWidth="720"
        MinHeight="480"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner"
        SourceInitialized="Window_OnSourceInitialized">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding ProfileName}"
                           Foreground="{StaticResource AccentBrush}"
                           FontSize="15"/>
                <TextBlock Text="  ·  "
                           Foreground="{StaticResource DisabledTextBrush}"
                           FontSize="15"/>
                <TextBlock Text="{Binding ProfileKind}"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="15"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="10,8"
                Margin="0,12,0,8">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowStoragePanel}" Value="False">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="1.35*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding StoragePanelTitle}"
                               FontSize="14"
                               FontWeight="SemiBold"
                               ToolTip="{Binding StoragePanelToolTip}"/>
                    <TextBlock Text="{Binding StorageStateDisplay}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding StorageStateDisplay}"
                               Visibility="{Binding UsesLinkedWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}"
                               Margin="0,1,0,0"/>
                </StackPanel>

                <UniformGrid Grid.Column="1"
                             Columns="3"
                             VerticalAlignment="Center"
                             Margin="18,0">
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding FirstMetricTitle}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   ToolTip="{Binding FirstMetricToolTip}"/>
                        <TextBlock Text="{Binding FirstMetricValue}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="{Binding SecondMetricTitle}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"
                                   ToolTip="{Binding SecondMetricToolTip}"/>
                        <TextBlock Text="{Binding SecondMetricValue}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                    <StackPanel ToolTip="{Binding ThirdMetricToolTip}">
                        <TextBlock Text="{Binding ThirdMetricTitle}"
                                   Foreground="{StaticResource MutedTextBrush}"
                                   FontSize="11"/>
                        <TextBlock Text="{Binding ThirdMetricValue}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,1,0,0"/>
                    </StackPanel>
                </UniformGrid>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Content="{x:Static res:Strings.Health_RebuildWorkspace}"
                            Command="{Binding RebuildWorkspaceCommand}"
                            Visibility="{Binding UsesLinkedWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Margin="0,0,8,0"/>
                    <Button Content="{x:Static res:Strings.Health_MoveWorkspace}"
                            Command="{Binding MoveWorkspaceCommand}"
                            Margin="0,0,8,0"/>
                    <Button Content="{x:Static res:Strings.Health_ClearCache}"
                            Command="{Binding ClearWorkspaceCommand}"
                            Visibility="{Binding UsesLinkedWorkspace, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Background="{StaticResource FieldBackgroundBrush}"
                BorderBrush="{StaticResource StrokeBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding Summary}"
                               FontSize="15"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{x:Static res:Strings.Health_WarningHint}"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Checks}"
                         BorderThickness="0"
                         infrastructure:SmoothScrollBehavior.IsEnabled="True"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        VerticalAlignment="Top"
                                        Margin="0,7,0,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource AccentGreenBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Status}" Value="Warning">
                                                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Status}" Value="Error">
                                                    <Setter Property="Background" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           FontWeight="SemiBold"
                                           Margin="8,0,12,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Details}"
                                           Foreground="{StaticResource MutedTextBrush}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Content="{x:Static res:Strings.Common_Refresh}"
                        Command="{Binding RefreshCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="{x:Static res:Strings.Common_Profile}"
                        Command="{Binding OpenProfileCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="{x:Static res:Strings.Health_Saves}"
                        Command="{Binding OpenSavesCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="{x:Static res:Strings.Health_LatestLog}"
                        Command="{Binding OpenLatestLogCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="{x:Static res:Strings.Check_CrashDump}"
                        Command="{Binding OpenCrashDumpCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="{x:Static res:Strings.Health_CopyReport}"
                        Command="{Binding CopyReportCommand}"/>
        </WrapPanel>
    </Grid>
</Window>
