<Window x:Class="StalkerModLauncher.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:StalkerModLauncher.Views.Controls"
        xmlns:res="clr-namespace:StalkerModLauncher.Resources"
        Title="{x:Static res:Strings.About_Title}"
        Width="700"
        Height="680"
        MinWidth="540"
        MinHeight="480"
        Background="{StaticResource WindowBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterScreen"
        SourceInitialized="AboutWindow_OnSourceInitialized">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <StackPanel>
                <TextBlock Text="CORDON"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/>
                <TextBlock Text="S.T.A.L.K.E.R. Mod Launcher"
                           FontSize="15"
                           Foreground="{StaticResource MutedTextBrush}"
                           Margin="0,1,0,0"/>
                <TextBlock x:Name="VersionTextBlock"
                           Margin="0,3,0,0"
                           Foreground="{StaticResource MutedTextBrush}"/>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <controls:AboutContentView Margin="0,0,10,0"/>
        </ScrollViewer>

        <CheckBox Grid.Row="2"
                  Margin="0,16,0,0"
                  IsChecked="{Binding DontShowAgain, RelativeSource={RelativeSource AncestorType=Window}}"
                  Content="{x:Static res:Strings.About_DontShowAtStartup}"
                  FontSize="12"
                  Foreground="{StaticResource MutedTextBrush}"
                  VerticalAlignment="Center"/>
    </Grid>
</Window>
