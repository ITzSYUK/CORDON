<Window x:Class="StalkerModLauncher.Views.SavesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:res="clr-namespace:StalkerModLauncher.Resources"
        Width="580" Height="575" MinWidth="380" MinHeight="260"
        Background="{StaticResource WindowBackgroundBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        SourceInitialized="Window_OnSourceInitialized" Loaded="Window_OnLoaded" PreviewKeyDown="Window_OnPreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ListBox x:Name="SavesList" Visibility="Collapsed"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="IsTabStop" Value="False"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,8,6"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="{DynamicResource PanelBrush}" CornerRadius="4">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                                </Border>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid x:Name="SaveRow" Height="78" Background="Transparent" ClipToBounds="True">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource FieldBackgroundBrush}" Margin="6,3" CornerRadius="3">
                            <Image Source="{Binding Thumbnail}" Width="128" Height="72" Stretch="Fill"/>
                        </Border>
                        <TextBlock Grid.Column="1" Margin="6,0,12,0" VerticalAlignment="Center"
                                   Text="{Binding Name}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                        <Border x:Name="ActionShade" Grid.Column="1" Opacity="0" Width="155"
                                CornerRadius="0,4,4,0"
                                HorizontalAlignment="Right" IsHitTestVisible="False">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="#00000000" Offset="0"/>
                                    <GradientStop Color="#C0000000" Offset="0.46"/>
                                    <GradientStop Color="#F2000000" Offset="0.72"/>
                                    <GradientStop Color="#F2000000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Button x:Name="LaunchButton" Grid.Column="1" Opacity="0"
                                IsHitTestVisible="False"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                AutomationProperties.Name="{x:Static res:Strings.Common_Launch}"
                                Click="LaunchButton_OnClick">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource InlineProfileActionButtonStyle}">
                                    <Setter Property="Width" Value="84"/>
                                    <Setter Property="Margin" Value="0,0,7,0"/>
                                    <Setter Property="Padding" Value="4,5"/>
                                </Style>
                            </Button.Style>
                            <Button.RenderTransform>
                                <TranslateTransform X="18"/>
                            </Button.RenderTransform>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{x:Static res:Strings.Common_Launch}" FontFamily="Bahnschrift SemiCondensed" FontSize="13"/>
                                <Viewbox Width="14" Height="14" Margin="4,0,0,0">
                                    <Canvas Width="16" Height="16">
                                        <Path Data="M4,2 L14,8 L4,14 Z" Fill="{DynamicResource AccentBrush}"/>
                                    </Canvas>
                                </Viewbox>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding CanLaunch, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                            <Setter TargetName="LaunchButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="ActionShade" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <Trigger SourceName="LaunchButton" Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="LaunchButton" Property="Opacity" Value="1"/>
                            <Setter TargetName="LaunchButton" Property="IsHitTestVisible" Value="True"/>
                            <Setter TargetName="ActionShade" Property="Opacity" Value="1"/>
                            <Setter TargetName="LaunchButton" Property="RenderTransform">
                                <Setter.Value><TranslateTransform/></Setter.Value>
                            </Setter>
                        </Trigger>
                        <EventTrigger RoutedEvent="MouseEnter" SourceName="SaveRow">
                            <BeginStoryboard x:Name="RevealLaunch">
                                <Storyboard>
                                    <BooleanAnimationUsingKeyFrames Storyboard.TargetName="LaunchButton" Storyboard.TargetProperty="IsHitTestVisible">
                                        <DiscreteBooleanKeyFrame KeyTime="0:0:0" Value="True"/>
                                    </BooleanAnimationUsingKeyFrames>
                                    <DoubleAnimation Storyboard.TargetName="ActionShade" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                                    <DoubleAnimation Storyboard.TargetName="LaunchButton" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.22"/>
                                    <DoubleAnimation Storyboard.TargetName="LaunchButton" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.22"/>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave" SourceName="SaveRow">
                            <RemoveStoryboard BeginStoryboardName="RevealLaunch"/>
                        </EventTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="StatusText" Text="{x:Static res:Strings.Saves_Loading}" TextAlignment="Center"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedTextBrush}"/>
        <DockPanel x:Name="SwmActions" Grid.Row="1" Visibility="Collapsed" Margin="0,10,0,0">
            <Button x:Name="OpenSwmButton" DockPanel.Dock="Right" Margin="12,0,0,0"
                    Content="{x:Static res:Strings.Saves_OpenSwmLauncher}" Click="OpenSwmButton_OnClick"/>
            <TextBlock Text="{x:Static res:Strings.Saves_SwmRequiresLauncher}" VerticalAlignment="Center"
                       Foreground="{DynamicResource MutedTextBrush}"/>
        </DockPanel>
    </Grid>
</Window>
